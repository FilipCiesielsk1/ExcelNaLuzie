---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase as link } from '../../utils/paths.js';
import { templateCatalog } from '../../data/templateCatalog.js';

export function getStaticPaths() {
  return templateCatalog.map((template) => ({
    params: { slug: template.slug },
    props: { template }
  }));
}

const { template } = Astro.props;
const canonical = '/szablony/' + template.slug + '/';
const absoluteUrl = 'https://excelnaluzie.pl' + canonical;
const suggestions = templateCatalog.filter(item => item.slug !== template.slug && (item.type === template.type || item.pro)).slice(0,3);

const schema = {
  '@context':'https://schema.org',
  '@graph':[
    {
      '@type':'WebPage',
      '@id': absoluteUrl + '#template',
      name: template.title,
      description: template.description,
      url: absoluteUrl,
      inLanguage:'pl-PL',
      author:{'@type':'Person',name:'Filip Ciesielski',url:'https://excelnaluzie.pl/o-serwisie/'},
      publisher:{'@type':'Organization',name:'ExcelNaLuzie.pl',url:'https://excelnaluzie.pl/'},
      about:{'@type':'SoftwareApplication',name:'Microsoft Excel',applicationCategory:'BusinessApplication'}
    },
    ...(template.faq ? [{
      '@type':'FAQPage',
      mainEntity:template.faq.map(([question,answer])=>({
        '@type':'Question',name:question,acceptedAnswer:{'@type':'Answer',text:answer}
      }))
    }] : []),
    {
      '@type':'BreadcrumbList',
      itemListElement:[
        {'@type':'ListItem',position:1,name:'ExcelNaLuzie',item:'https://excelnaluzie.pl/'},
        {'@type':'ListItem',position:2,name:'Szablony Excel',item:'https://excelnaluzie.pl/szablony/'},
        {'@type':'ListItem',position:3,name:template.title,item:absoluteUrl}
      ]
    }
  ]
};
---

<BaseLayout
  navSection="szablony"
  title={template.title + ' — podgląd szablonu Excel | ExcelNaLuzie'}
  description={template.description + ' Pobieranie XLSX jest tymczasowo wstrzymane do zakończenia dopracowywania plików.'}
  canonical={canonical}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

  <div class="template-detail-page">
    <div class="template-detail-wrap">
      <nav class="breadcrumbs" aria-label="Okruszki">
        <a href={link("/")}>ExcelNaLuzie</a>
        <span>›</span>
        <a href={link("/szablony/")}>Szablony</a>
        <span>›</span>
        <strong>{template.title}</strong>
      </nav>

      <header class="template-detail-hero">
        <div class="template-detail-copy">
          <div class="template-badges">
            <span>XLSX</span>
            <span>Podgląd</span>
            {template.pro && <span>PRO</span>}
            <span>{template.version}</span>
          </div>
          <h1>{template.title}</h1>
          <p>{template.description}</p>
          {template.audience && <p class="pro-template-audience">{template.audience}</p>}
          <p class="template-pause-notice" role="status"><strong>Pobieranie szablonów jest tymczasowo wstrzymane.</strong> Plik przechodzi przegląd jakości. Opis funkcji i podgląd nadal możesz obejrzeć.</p>
          <div class="template-detail-actions">
            <span class="template-download-disabled" aria-disabled="true">Pobieranie chwilowo niedostępne</span>
            <a class="template-detail-secondary" href="#instrukcja">Zobacz instrukcję</a>
          </div>
        </div>

        <div class="xlsx-preview" aria-label={'Podgląd szablonu ' + template.title}>
          <div class="xlsx-preview-top">
            <div><i></i><i></i><i></i></div>
            <strong>{template.title}.xlsx</strong>
            <span>Podgląd przykładowy</span>
          </div>
          <div class="xlsx-preview-bar"><b>fx</b><span>=PODSUMOWANIE()</span></div>
          <div class="xlsx-preview-body">
            <div class="xlsx-preview-title">{template.title}</div>
            <div class="xlsx-kpis">
              <div><small>{template.preview.label1}</small><strong>{template.preview.value1}</strong></div>
              <div><small>{template.preview.label2}</small><strong>{template.preview.value2}</strong></div>
              <div><small>{template.preview.label3}</small><strong>{template.preview.value3}</strong></div>
            </div>
            <div class="xlsx-preview-table">
              <div class="xlsx-preview-row head"><span>Pozycja</span><span>Wynik</span></div>
              {template.preview.rows.map((row) => (
                <div class="xlsx-preview-row"><span>{row[0]}</span><b>{row[1]}</b></div>
              ))}
            </div>
          </div>
          <p class="xlsx-preview-note">Wartości w tym podglądzie są ilustracyjne. Plik XLSX zostanie udostępniony po zakończeniu przeglądu jakości.</p>
          <div class="xlsx-preview-tabs">
            {template.sheets.map((sheet, index) => <span class:list={{active:index===0}}>{sheet}</span>)}
          </div>
        </div>
      </header>

      <section class="template-detail-section">
        <div class="template-detail-heading">
          <span class="section-kicker">W środku</span>
          <h2>Co zawiera projekt?</h2>
        </div>
        <div class="template-feature-grid">
          {template.features.map((feature, index) => (
            <div>
              <span>{String(index + 1).padStart(2,'0')}</span>
              <p>{feature}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="template-detail-section template-use-section" id="instrukcja">
        <div class="template-detail-heading">
          <span class="section-kicker">Instrukcja</span>
          <h2>Jak użyć szablonu?</h2>
        </div>
        <div class="template-use-grid">
          {template.steps.map((step, index) => (
            <div>
              <span>{index + 1}</span>
              <p>{step}</p>
            </div>
          ))}
        </div>
      </section>

      {template.faq && <section class="template-detail-section pro-template-faq" aria-labelledby="template-faq-title">
        <div class="template-detail-heading"><span class="section-kicker">Najczęstsze pytania</span><h2 id="template-faq-title">Pytania o szablon</h2></div>
        <div class="pro-template-faq-list">{template.faq.map(([question,answer])=>(
          <details><summary>{question}</summary><p>{answer}</p></details>
        ))}</div>
      </section>}
      {template.pro && <section class="template-detail-section pro-template-related">
        <div class="template-detail-heading"><span class="section-kicker">Może Ci się przydać</span><h2>Podobne szablony Excel</h2></div>
        <div class="pro-template-related-grid">{suggestions.map(other=>(
          <a href={link('/szablony/'+other.slug+'/')}><strong>{other.title}</strong><span>Zobacz podgląd →</span></a>
        ))}</div>
      </section>}

      <section class="template-requirements">
        <div>
          <span>Wymagana wersja</span>
          <strong>{template.version}</strong>
          <p>Plik nie używa makr. Otwierasz zwykły format .xlsx.</p>
        </div>
        <div>
          <span>Arkusze w pliku</span>
          <strong>{template.sheets.length}</strong>
          <p>{template.sheets.join(' · ')}</p>
        </div>
        <div>
          <span>Dane przykładowe</span>
          <strong>Tak</strong>
          <p>W docelowym pliku będzie można zastąpić je własnymi danymi.</p>
        </div>
      </section>

      <section class="template-bottom-download">
        <div>
          <span class="section-kicker light">Biblioteka szablonów</span>
          <h2>{template.title}</h2>
          <p>Podgląd i instrukcja są dostępne. Pobieranie XLSX zostanie włączone po zakończeniu dopracowywania szablonu.</p>
        </div>
        <span class="template-bottom-paused" aria-disabled="true">Pobieranie wstrzymane</span>
      </section>
    </div>
  </div>
</BaseLayout>
