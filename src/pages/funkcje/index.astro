---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase as link } from '../../utils/paths.js';
import { functionCatalog } from '../../data/functionCatalog.js';

const schema = {
  '@context':'https://schema.org',
  '@graph':[
    {
      '@type':'CollectionPage',
      name:'Funkcje Excel — baza funkcji po polsku',
      url:'https://excelnaluzie.pl/funkcje/',
      inLanguage:'pl-PL',
      mainEntity:{
        '@type':'ItemList',
        numberOfItems:functionCatalog.length,
        itemListElement:functionCatalog.map((fn,index)=>({
          '@type':'ListItem',
          position:index+1,
          name:fn.name,
          url:'https://excelnaluzie.pl/funkcje/' + fn.slug + '/'
        }))
      }
    },
    {
      '@type':'BreadcrumbList',
      itemListElement:[
        {'@type':'ListItem',position:1,name:'ExcelNaLuzie',item:'https://excelnaluzie.pl/'},
        {'@type':'ListItem',position:2,name:'Funkcje Excel',item:'https://excelnaluzie.pl/funkcje/'}
      ]
    }
  ]
};
---

<BaseLayout
  navSection="funkcje"
  title="Funkcje Excel — baza funkcji po polsku | ExcelNaLuzie"
  description="Baza funkcji Excel po polsku: składnia, zastosowanie, praktyczne przykłady i powiązane poradniki."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

  <section class="hub-hero hub-functions">
    <div class="wrap hub-hero-grid">
      <div>
        <nav class="hub-breadcrumbs"><a href={link("/")}>ExcelNaLuzie</a><span>›</span><strong>Funkcje</strong></nav>
        <span class="hub-kicker">Baza funkcji</span>
        <h1>Każda funkcja.<br/><em>Po ludzku.</em></h1>
        <p>Składnia, argumenty i przykłady użycia bez przepisywania dokumentacji. Zacznij od funkcji, którą chcesz zrozumieć.</p>
        <div class="hub-actions">
          <a class="hub-primary" href="#popularne">Przeglądaj funkcje <span>↓</span></a>
          <a class="hub-secondary" href={link("/formuly/")}>Przejdź do formuł</a>
        </div>
      </div>

      <div class="function-reference" aria-hidden="true">
        <div class="ref-top"><span>fx</span><strong>X.WYSZUKAJ</strong><i>Microsoft 365 / 2024 / 2021</i></div>
        <div class="ref-syntax">=X.WYSZUKAJ(szukana_wartość;szukana_tablica;zwracana_tablica)</div>
        <div class="ref-args">
          <div><b>01</b><span>szukana_wartość</span><i>czego szukasz</i></div>
          <div><b>02</b><span>szukana_tablica</span><i>gdzie szukasz</i></div>
          <div><b>03</b><span>zwracana_tablica</span><i>co zwrócić</i></div>
        </div>
      </div>
    </div>
  </section>

  <section class="hub-section" id="popularne">
    <div class="wrap">
      <div class="hub-section-head">
        <div><span class="section-kicker">Pierwszy etap</span><h2>{functionCatalog.length} funkcji gotowych</h2></div>
        <p>Każda strona ma składnię, opis argumentów, prosty przykład, typowe zastosowania i link do dokumentacji Microsoftu.</p>
      </div>

      <div class="function-grid">
        {functionCatalog.map((fn) => (
          <article class:list={['function-card', { highlighted: fn.slug === 'xwyszukaj' }]}>
            <div>
              <span class="function-symbol">{fn.name}</span>
              <small>{fn.category}</small>
            </div>
            <p>{fn.description}</p>
            <code>{fn.example}</code>
            <a href={link('/funkcje/' + fn.slug + '/')}>Otwórz funkcję →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="hub-section hub-section-alt">
    <div class="wrap">
      <div class="hub-section-head">
        <div><span class="section-kicker">Jak czytać bazę</span><h2>Jedna funkcja, jeden schemat</h2></div>
        <p>Każda strona jest zbudowana tak samo, żeby potrzebną informację dało się znaleźć od razu.</p>
      </div>
      <div class="reference-steps">
        <div><span>01</span><strong>Składnia i argumenty</strong><p>Najpierw dokładny zapis funkcji i krótki opis każdego argumentu.</p></div>
        <div><span>02</span><strong>Prosty przykład</strong><p>Minimalna formuła pokazująca, co faktycznie robi funkcja.</p></div>
        <div><span>03</span><strong>Praktyczne użycie</strong><p>Najczęstsze warianty, pułapki i przejście do powiązanych poradników.</p></div>
      </div>
    </div>
  </section>

  <section class="hub-cta-section">
    <div class="wrap hub-cta">
      <div><span class="section-kicker light">Nie znasz nazwy funkcji?</span><h2>To żaden problem.</h2><p>W sekcji Formuły zaczynasz od efektu, który chcesz osiągnąć.</p></div>
      <a href={link("/formuly/")}>Znajdź rozwiązanie <span>→</span></a>
    </div>
  </section>
</BaseLayout>
