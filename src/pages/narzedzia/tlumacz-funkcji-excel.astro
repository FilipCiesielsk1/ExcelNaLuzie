---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { functionTranslations } from '../../data/functionTranslations.js';

const functionCount = functionTranslations.length;
---

<ToolLayout
  title="Tłumacz nazw funkcji Excel PL ↔ EN"
  description={`Wpisz polską lub angielską nazwę funkcji Excela i znajdź odpowiednik. Słownik zawiera ${functionCount} popularnych funkcji.`}
  slug="tlumacz-funkcji-excel"
  functionName="Baza funkcji Excel"
  functionHref="/funkcje/"
  resourceLabel="Pełna baza"
  resourceAction="Przejdź do funkcji →"
>
  <div class="generator-intro">
    <span class="section-kicker">Słownik funkcji</span>
    <h2>Polski Excel ↔ angielski Excel</h2>
    <p>Wpisz co najmniej 2 znaki polskiej lub angielskiej nazwy. Podpowiedzi pojawią się automatycznie.</p>
  </div>

  <div class="formula-generator" data-function-translator>
    <div class="generator-grid">
      <div class="generator-field translator-search">
        <label for="translator-input">Nazwa funkcji</label>
        <input
          id="translator-input"
          data-input
          value="JEŻELI"
          spellcheck="false"
          autocomplete="off"
          aria-autocomplete="list"
          aria-controls="translator-suggestions"
          aria-expanded="false"
        />
        <small>Możesz wpisać np. jez, wysz, count, text albo network.</small>
        <div
          id="translator-suggestions"
          class="translator-suggestions hidden"
          data-suggestions
          role="listbox"
          aria-label="Podpowiedzi funkcji"
        ></div>
      </div>
    </div>

    <div class="translator-meta">
      <span><strong>{functionCount}</strong> funkcji w słowniku</span>
      <span>polski ↔ angielski</span>
      <span>wyszukiwanie po fragmencie</span>
    </div>

    <div class="generator-output">
      <div><span>Polska nazwa</span><small>Do polskiej wersji Excela.</small></div>
      <code data-pl aria-live="polite">JEŻELI</code>
      <button type="button" data-copy-pl>Kopiuj</button>
    </div>

    <div class="generator-output">
      <div><span>Angielska nazwa</span><small>Do angielskiej wersji Excela.</small></div>
      <code data-en aria-live="polite">IF</code>
      <button type="button" data-copy-en>Kopiuj</button>
    </div>

    <div class="column-converter-message" data-message aria-live="polite">
      Znaleziono funkcję.
    </div>
  </div>

  <div class="generator-help">
    <h2>Jak działa wyszukiwanie?</h2>
    <p>Po wpisaniu dwóch znaków narzędzie pokazuje maksymalnie 12 najlepiej pasujących funkcji. Najpierw pojawiają się nazwy zaczynające się od wpisanego tekstu, a potem pozostałe wyniki zawierające ten fragment.</p>
    <p>Możesz szukać po nazwie polskiej albo angielskiej. Wyszukiwanie ignoruje wielkość liter i polskie znaki, więc wpisanie <strong>jez</strong> znajdzie również <strong>JEŻELI</strong>.</p>
  </div>

  <script type="application/json" id="function-translations-data" set:html={JSON.stringify(functionTranslations)}></script>

  <script>
    const root = document.querySelector('[data-function-translator]');
    const input = root.querySelector('[data-input]');
    const pl = root.querySelector('[data-pl]');
    const en = root.querySelector('[data-en]');
    const message = root.querySelector('[data-message]');
    const suggestions = root.querySelector('[data-suggestions]');
    const dataNode = document.getElementById('function-translations-data');
    const pairs = JSON.parse(dataNode.textContent || '[]');

    let activeIndex = -1;
    let currentMatches = [];
    let hasInteracted = false;

    const normalize = (value) => value
      .trim()
      .toUpperCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');

    const exactPair = (query) => pairs.find(([polish, english]) =>
      normalize(polish) === query || normalize(english) === query
    );

    const findMatches = (query) => {
      if (query.length < 2) return [];

      return pairs
        .map((pair) => {
          const plName = normalize(pair[0]);
          const enName = normalize(pair[1]);
          const starts = plName.startsWith(query) || enName.startsWith(query);
          const contains = plName.includes(query) || enName.includes(query);
          const exact = plName === query || enName === query;
          return { pair, score: exact ? 0 : starts ? 1 : contains ? 2 : 99 };
        })
        .filter((item) => item.score < 99)
        .sort((a, b) => a.score - b.score || a.pair[0].localeCompare(b.pair[0], 'pl'))
        .slice(0, 12)
        .map((item) => item.pair);
    };

    const setResult = (pair) => {
      pl.textContent = pair[0];
      en.textContent = pair[1];
      message.textContent = pair[0] === pair[1]
        ? 'Ta funkcja ma tę samą nazwę w polskim i angielskim Excelu.'
        : 'Znaleziono funkcję. Możesz skopiować wybraną nazwę.';
      message.classList.remove('error');
    };

    const closeSuggestions = () => {
      suggestions.classList.add('hidden');
      suggestions.classList.remove('open-up');
      suggestions.replaceChildren();
      suggestions.removeAttribute('style');
      input.setAttribute('aria-expanded', 'false');
      activeIndex = -1;
      currentMatches = [];
    };

    const placeSuggestions = () => {
      if (suggestions.classList.contains('hidden')) return;

      const rect = input.getBoundingClientRect();
      const viewportWidth = window.innerWidth;
      const viewportHeight = window.innerHeight;
      const mobile = viewportWidth <= 640;

      const left = mobile ? 12 : Math.max(12, rect.left);
      const width = mobile
        ? Math.max(280, viewportWidth - 24)
        : Math.min(Math.max(rect.width, 430), viewportWidth - left - 12);

      suggestions.style.left = left + 'px';
      suggestions.style.width = width + 'px';
      suggestions.style.right = 'auto';

      const desiredHeight = Math.min(suggestions.scrollHeight, mobile ? 420 : 390);
      const spaceBelow = viewportHeight - rect.bottom - 12;
      const spaceAbove = rect.top - 12;
      const openAbove = spaceBelow < Math.min(desiredHeight, 240) && spaceAbove > spaceBelow;

      suggestions.classList.toggle('open-up', openAbove);

      if (openAbove) {
        const height = Math.min(desiredHeight, Math.max(160, spaceAbove - 8));
        suggestions.style.maxHeight = height + 'px';
        suggestions.style.top = Math.max(12, rect.top - height - 8) + 'px';
      } else {
        const height = Math.min(desiredHeight, Math.max(160, spaceBelow - 8));
        suggestions.style.maxHeight = height + 'px';
        suggestions.style.top = Math.min(viewportHeight - 12, rect.bottom + 8) + 'px';
      }
    };

    const selectMatch = (pair) => {
      input.value = pair[0];
      setResult(pair);
      closeSuggestions();
      input.focus();
    };

    const renderSuggestions = (matches) => {
      suggestions.replaceChildren();
      currentMatches = matches;
      activeIndex = -1;

      if (!hasInteracted || !matches.length) {
        closeSuggestions();
        return;
      }

      matches.forEach((pair, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'translator-suggestion';
        button.setAttribute('role', 'option');
        button.dataset.index = String(index);

        const names = document.createElement('span');
        names.className = 'translator-suggestion-names';

        const polish = document.createElement('strong');
        polish.textContent = pair[0];

        const english = document.createElement('code');
        english.textContent = pair[1];

        names.append(polish, english);

        const category = document.createElement('small');
        category.textContent = pair[2];

        button.append(names, category);
        button.addEventListener('mousedown', (event) => {
          event.preventDefault();
          selectMatch(pair);
        });

        suggestions.appendChild(button);
      });

      suggestions.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(placeSuggestions);
    };

    const updateActive = () => {
      suggestions.querySelectorAll('[role="option"]').forEach((item, index) => {
        const active = index === activeIndex;
        item.classList.toggle('active', active);
        item.setAttribute('aria-selected', active ? 'true' : 'false');
        if (active) item.scrollIntoView({ block: 'nearest' });
      });
    };

    const update = (showSuggestions = false) => {
      const query = normalize(input.value);

      if (!query) {
        pl.textContent = '—';
        en.textContent = '—';
        message.textContent = 'Wpisz co najmniej 2 znaki nazwy funkcji.';
        message.classList.remove('error');
        closeSuggestions();
        return;
      }

      const matches = findMatches(query);
      const exact = exactPair(query);

      if (exact) {
        setResult(exact);
      } else {
        pl.textContent = '—';
        en.textContent = '—';
        message.textContent = query.length < 2
          ? 'Wpisz jeszcze jeden znak, aby zobaczyć podpowiedzi.'
          : matches.length
            ? 'Wybierz funkcję z podpowiedzi.'
            : 'Nie znaleziono funkcji pasującej do wpisanego tekstu.';
        message.classList.toggle('error', query.length >= 2 && matches.length === 0);
      }

      if (showSuggestions && query.length >= 2) {
        renderSuggestions(matches);
      } else {
        closeSuggestions();
      }
    };

    input.addEventListener('input', () => {
      hasInteracted = true;
      update(true);
    });

    input.addEventListener('focus', () => {
      if (hasInteracted && normalize(input.value).length >= 2) update(true);
    });

    input.addEventListener('keydown', (event) => {
      if (suggestions.classList.contains('hidden') || !currentMatches.length) {
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          hasInteracted = true;
          update(true);
          if (currentMatches.length) {
            activeIndex = 0;
            updateActive();
          }
        }
        return;
      }

      if (event.key === 'ArrowDown') {
        event.preventDefault();
        activeIndex = (activeIndex + 1) % currentMatches.length;
        updateActive();
      }

      if (event.key === 'ArrowUp') {
        event.preventDefault();
        activeIndex = activeIndex <= 0 ? currentMatches.length - 1 : activeIndex - 1;
        updateActive();
      }

      if (event.key === 'Enter' && activeIndex >= 0) {
        event.preventDefault();
        selectMatch(currentMatches[activeIndex]);
      }

      if (event.key === 'Escape') {
        closeSuggestions();
      }
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target) && !suggestions.contains(event.target)) closeSuggestions();
    });

    window.addEventListener('resize', placeSuggestions);
    window.addEventListener('scroll', placeSuggestions, true);

    const copy = async (value, button) => {
      if (!value || value === '—') return;
      try {
        await navigator.clipboard.writeText(value);
        button.textContent = 'Skopiowano ✓';
        setTimeout(() => button.textContent = 'Kopiuj', 1500);
      } catch {
        button.textContent = 'Zaznacz ręcznie';
      }
    };

    root.querySelector('[data-copy-pl]').addEventListener('click', (event) =>
      copy(pl.textContent, event.currentTarget)
    );
    root.querySelector('[data-copy-en]').addEventListener('click', (event) =>
      copy(en.textContent, event.currentTarget)
    );

    update(false);
  </script>

  <div class="generator-help">
    <h2>Co tłumaczy narzędzie?</h2>
    <p>Tłumacz dotyczy nazw funkcji, nie całych formuł. Separatory argumentów i formaty liczb zależą od ustawień regionalnych Excela, dlatego automatyczna zamiana całej formuły wymaga osobnego parsera składni.</p>
    <p>Słownik koncentruje się na najczęściej używanych funkcjach logicznych, tekstowych, wyszukujących, dat, statystycznych, matematycznych i tablic dynamicznych.</p>
  </div>
</ToolLayout>

<style is:global>
  .translator-search {
    position: relative;
  }

  .translator-suggestions {
    position: fixed;
    z-index: 1000;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    background:
      linear-gradient(180deg, rgba(255,255,255,.98), rgba(250,251,250,.98));
    border: 1px solid rgba(20, 29, 39, .13);
    border-radius: 16px;
    box-shadow:
      0 22px 60px rgba(20, 29, 39, .18),
      0 3px 12px rgba(20, 29, 39, .08);
    padding: 7px;
    backdrop-filter: blur(14px);
    scrollbar-width: thin;
  }

  .translator-suggestions::before {
    content: 'Podpowiedzi';
    display: block;
    padding: 6px 10px 7px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: rgba(20, 29, 39, .48);
  }

  .translator-suggestions.open-up::before {
    content: 'Podpowiedzi';
  }

  .translator-suggestions.hidden {
    display: none;
  }

  .translator-suggestion {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border: 0;
    border-radius: 11px;
    background: transparent;
    padding: 11px 12px;
    min-height: 48px;
    text-align: left;
    cursor: pointer;
    color: inherit;
  }

  .translator-suggestion:hover,
  .translator-suggestion.active {
    background: rgba(50, 120, 90, .10);
  }

  .translator-suggestion + .translator-suggestion {
    border-top: 1px solid rgba(20, 29, 39, .055);
  }

  .translator-suggestion-names {
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  .translator-suggestion strong {
    font-size: 14px;
  }

  .translator-suggestion code {
    font-size: 12px;
    font-weight: 650;
    opacity: .72;
    background: rgba(20, 29, 39, .055);
    border-radius: 7px;
    padding: 3px 6px;
  }

  .translator-suggestion small {
    flex: 0 0 auto;
    font-size: 11px;
    opacity: .58;
  }

  .translator-meta {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: -2px 0 18px;
  }

  .translator-meta span {
    border: 1px solid rgba(20, 29, 39, .12);
    border-radius: 999px;
    padding: 6px 10px;
    font-size: 12px;
  }

  @media (max-width: 640px) {
    .translator-suggestions {
      border-radius: 18px;
      padding: 7px;
      max-width: calc(100vw - 24px);
      box-shadow:
        0 18px 44px rgba(20, 29, 39, .22),
        0 2px 8px rgba(20, 29, 39, .08);
    }

    .translator-suggestion {
      align-items: center;
      padding: 12px;
      min-height: 52px;
    }

    .translator-suggestion-names {
      gap: 7px;
    }

    .translator-suggestion strong {
      font-size: 13px;
      overflow-wrap: anywhere;
    }

    .translator-suggestion code {
      font-size: 11px;
      overflow-wrap: anywhere;
    }

    .translator-suggestion small {
      display: none;
    }
  }
</style>
