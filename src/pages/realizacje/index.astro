---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase as link } from '../../utils/paths.js';
import '../../styles/portfolio.css';
const site='https://excelnaluzie.pl';
const schema={
  '@context':'https://schema.org',
  '@graph':[
    {'@type':'CollectionPage','@id':site+'/realizacje/#page',name:'Realizacje Excel i VBA — autorskie rozwiązania',url:site+'/realizacje/',inLanguage:'pl-PL',
      description:'Zobacz autorskie rozwiązania Excel i VBA: dashboardy, raportowanie, automatyzacje i narzędzia analityczne.',
      mainEntity:{'@type':'ItemList',numberOfItems:1,itemListElement:[
        {'@type':'ListItem',position:1,name:'Sales Performance Dashboard PRO',url:site+'/realizacje/sales-performance-dashboard/'}
      ]}},
    {'@type':'BreadcrumbList','itemListElement':[
      {'@type':'ListItem',position:1,name:'ExcelNaLuzie',item:site+'/'},
      {'@type':'ListItem',position:2,name:'Realizacje',item:site+'/realizacje/'}
    ]}
  ]
};
---
<BaseLayout
  title="Realizacje Excel i VBA — portfolio | ExcelNaLuzie"
  description="Autorskie realizacje Excel i VBA: dashboardy, analiza sprzedaży, automatyzacje i raportowanie. Zobacz funkcje, technologie i możliwości współpracy."
  canonical="/realizacje/"
  image="/media/realizacje/sales-performance-dashboard/01_dashboard_glowny.webp"
  navSection="realizacje"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <div class="portfolio-page" data-pagefind-body>
    <section class="portfolio-intro">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Okruszki">
          <a href={link('/')}>ExcelNaLuzie</a><span>›</span><strong>Realizacje</strong>
        </nav>
        <span class="portfolio-eyebrow">Portfolio Excel / VBA</span>
        <h1>Od danych do <em>gotowych narzędzi biznesowych.</em></h1>
        <p>Poznaj rozwiązania, które łączą analitykę, automatyzację i intuicyjny interfejs. Każdy projekt opisuję od strony funkcjonalnej — co robi, jak działa i do jakich zadań może się przydać.</p>
        <div class="portfolio-actions">
          <a class="primary" href="#projekty">Przeglądaj realizacje ↓</a>
          <a class="secondary" href={link('/uslugi/excel-vba/')+'#zapytanie'}>Zapytaj o własne rozwiązanie</a>
        </div>
      </div>
    </section>
    <section class="portfolio-section" id="projekty">
      <div class="wrap">
        <div class="portfolio-projects-head">
          <div>
            <span class="portfolio-eyebrow">Portfolio projektów</span>
            <h2 class="portfolio-heading">Rozwiązania Excel i VBA</h2>
            <p class="portfolio-subheading">Przy każdym projekcie znajdziesz opis zastosowania, ekranów i najważniejszych funkcji. Kolejne realizacje będą pojawiać się w tym samym katalogu.</p>
          </div>
        </div>
        <span class="portfolio-eyebrow">01 / Analityka sprzedaży</span>
        <div class="portfolio-feature" style="margin-top:18px;">
          <div>
            <h2>Sales Performance Dashboard PRO</h2>
            <p>Rozbudowana aplikacja w Excelu z centralnym dashboardem KPI, analizą marży, wynikami regionów, celami handlowymi i automatyzacją VBA.</p>
            <ul>
              <li>8 wskaźników KPI i 5 wykresów zarządczych</li>
              <li>Filtry rok / miesiąc / region</li>
              <li>Import danych CSV i eksport raportu PDF</li>
              <li>7 arkuszy, tabele danych i model analityczny</li>
            </ul>
            <div class="portfolio-tech"><span>Excel</span><span>VBA</span><span>Dashboard</span><span>CSV</span><span>PDF</span></div>
            <div class="portfolio-actions">
              <a class="primary" href={link('/realizacje/sales-performance-dashboard/')}>Poznaj projekt →</a>
            </div>
          </div>
          <figure class="portfolio-listing-preview">
            <a href={link('/realizacje/sales-performance-dashboard/')} aria-label="Zobacz Sales Performance Dashboard PRO i nagrania jego działania">
              <img src={link('/media/realizacje/sales-performance-dashboard/01_dashboard_glowny.webp')} width="1920" height="1032" alt="Prawdziwy zrzut ekranu Sales Performance Dashboard PRO z ośmioma KPI, wykresami i filtrami w Excelu" loading="lazy" decoding="async"/>
              <span>Zobacz zrzuty i nagrania →</span>
            </a>
          </figure>
        </div>
      </div>
    </section>
    <section class="portfolio-section portfolio-upcoming-section" aria-labelledby="portfolio-next-heading">
      <div class="wrap">
        <span class="portfolio-eyebrow">Kolejne pozycje w portfolio</span>
        <h2 class="portfolio-heading" id="portfolio-next-heading">Miejsce na następne realizacje</h2>
        <p class="portfolio-subheading">Przygotowuję kolejne projekty. Poniższe karty pokazują planowane obszary — nie są jeszcze opublikowanymi realizacjami.</p>
        <div class="portfolio-upcoming-grid">
          <article class="portfolio-upcoming-card">
            <span class="portfolio-upcoming-status">W przygotowaniu</span>
            <div class="portfolio-upcoming-symbol" aria-hidden="true">↗</div>
            <h3>Transport Planner PRO</h3>
            <p>System do planowania transportów, przydzielania kierowców i pojazdów oraz kontroli konfliktów zasobów.</p>
            <span class="portfolio-upcoming-category">Planowanie operacyjne · Excel / VBA</span>
          </article>
          <article class="portfolio-upcoming-card portfolio-upcoming-card-empty">
            <span class="portfolio-upcoming-status">Miejsce na kolejny projekt</span>
            <div class="portfolio-upcoming-symbol" aria-hidden="true">+</div>
            <h3>Następna realizacja</h3>
            <p>Tutaj pojawi się kolejny projekt wraz z opisem działania, zdjęciami i prezentacją najważniejszych funkcji.</p>
            <span class="portfolio-upcoming-category">Nowy projekt · Wkrótce</span>
          </article>
        </div>
      </div>
    </section>
    <section class="portfolio-section">
      <div class="wrap">
        <h2 class="portfolio-heading">Jakie rozwiązania można zbudować w Excelu?</h2>
        <p class="portfolio-subheading">Dobrze zaprojektowany arkusz może pełnić funkcję systemu raportowania, aplikacji operacyjnej lub narzędzia automatyzującego powtarzalne czynności.</p>
        <div class="portfolio-grid">
          <article class="portfolio-card"><span class="symbol">Σ</span><h3>Raporty i KPI</h3><p>Analiza sprzedaży, kosztów, realizacji celów i rentowności z czytelną prezentacją wyników.</p></article>
          <article class="portfolio-card"><span class="symbol">↺</span><h3>Automatyzacje VBA</h3><p>Przetwarzanie plików, uzupełnianie raportów, walidacja danych i powtarzalne procesy uruchamiane przyciskiem.</p></article>
          <article class="portfolio-card"><span class="symbol">⇄</span><h3>Import i eksport danych</h3><p>Praca z CSV, raportami PDF, tabelami źródłowymi oraz uporządkowanymi danymi wejściowymi.</p></article>
        </div>
      </div>
    </section>
    <section class="portfolio-section">
      <div class="wrap">
        <div class="portfolio-cta">
          <div><h2>Potrzebujesz podobnego narzędzia?</h2><p>Opisz swoje dane, aktualny sposób raportowania i oczekiwany wynik. Sprawdzimy, jak zaprojektować rozwiązanie dopasowane do procesu.</p></div>
          <a href={link('/uslugi/excel-vba/')+'#zapytanie'}>Przejdź do współpracy →</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
