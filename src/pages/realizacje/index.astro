---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase as link } from '../../utils/paths.js';
import '../../styles/portfolio.css';
const site='https://excelnaluzie.pl';
const schema={
  '@context':'https://schema.org',
  '@graph':[
    {'@type':'CollectionPage','@id':site+'/realizacje/#page',name:'Realizacje Excel i VBA — autorskie rozwiązania',url:site+'/realizacje/',inLanguage:'pl-PL',
      description:'Zobacz autorskie rozwiązania Excel i VBA: dashboardy, raportowanie, automatyzacje i narzędzia analityczne.',
      mainEntity:{'@type':'ItemList',numberOfItems:1,itemListElement:[
        {'@type':'ListItem',position:1,name:'Sales Performance Dashboard PRO',url:site+'/realizacje/sales-performance-dashboard/'}
      ]}},
    {'@type':'BreadcrumbList','itemListElement':[
      {'@type':'ListItem',position:1,name:'ExcelNaLuzie',item:site+'/'},
      {'@type':'ListItem',position:2,name:'Realizacje',item:site+'/realizacje/'}
    ]}
  ]
};
---
<BaseLayout
  title="Realizacje Excel i VBA — portfolio | ExcelNaLuzie"
  description="Autorskie realizacje Excel i VBA: dashboardy, analiza sprzedaży, automatyzacje i raportowanie. Zobacz funkcje, technologie i możliwości współpracy."
  canonical="/realizacje/"
  image="/media/realizacje/sales-performance-dashboard/01_dashboard_glowny.webp"
  navSection="realizacje"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <div class="portfolio-page" data-pagefind-body>
    <section class="portfolio-intro">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Okruszki">
          <a href={link('/')}>ExcelNaLuzie</a><span>›</span><strong>Realizacje</strong>
        </nav>
        <span class="portfolio-eyebrow">Portfolio Excel / VBA</span>
        <h1>Od danych do <em>gotowych narzędzi biznesowych.</em></h1>
        <p>Poznaj rozwiązania, które łączą analitykę, automatyzację i intuicyjny interfejs. Od raportowania wyników po planowanie zasobów i procesów firmowych.</p>
        <div class="portfolio-actions">
          <a class="primary" href="#projekty">Przeglądaj realizacje ↓</a>
          <a class="secondary" href={link('/uslugi/excel-vba/')+'#zapytanie'}>Zapytaj o własne rozwiązanie</a>
        </div>
      </div>
    </section>
    <section class="portfolio-section portfolio-gallery-section" id="projekty" aria-labelledby="portfolio-gallery-heading">
      <div class="wrap">
        <div class="portfolio-gallery-heading">
          <div>
            <span class="portfolio-eyebrow">Wybrane rozwiązania</span>
            <h2 class="portfolio-heading" id="portfolio-gallery-heading">Portfolio Excel / VBA</h2>
            <p class="portfolio-subheading">Systemy do analizy, planowania i zarządzania procesami biznesowymi. Zobacz różne możliwości zastosowania Excela poza zwykłym arkuszem.</p>
          </div>
        </div>
        <div class="portfolio-showcase-grid">
          <article class="portfolio-showcase-card">
            <a class="portfolio-showcase-media portfolio-showcase-media-link" href={link('/realizacje/sales-performance-dashboard/')} aria-label="Zobacz Sales Performance Dashboard PRO">
              <img src={link('/media/realizacje/sales-performance-dashboard/01_dashboard_glowny.webp')} width="1920" height="1032" alt="Ekran Sales Performance Dashboard PRO z KPI, filtrami i wykresami" loading="lazy" decoding="async"/>
            </a>
            <div class="portfolio-showcase-body">
              <span class="portfolio-showcase-category">01 / Dashboard i analityka</span>
              <h3><a href={link('/realizacje/sales-performance-dashboard/')}>Sales Performance Dashboard PRO</a></h3>
              <p>Panel KPI, analiza przychodów i marży, porównanie wyników z celami sprzedaży, import CSV oraz eksport PDF.</p>
              <div class="portfolio-showcase-tags"><span>Excel</span><span>VBA</span><span>Raportowanie</span></div>
              <a class="portfolio-showcase-link" href={link('/realizacje/sales-performance-dashboard/')}>Zobacz szczegóły <span aria-hidden="true">→</span></a>
            </div>
          </article>

          <article class="portfolio-showcase-card">
            <div class="portfolio-showcase-media portfolio-visual-transport" role="img" aria-label="Koncepcyjny podgląd tygodniowego planu transportów z tabelą kierowców i tras">
              <div class="pv-top"><strong>TRANSPORT PLANNER</strong><span>PLAN TYGODNIOWY</span></div>
              <div class="pv-sub"><span>‹</span><b>Tydzień 42 / 2026</b><span>›</span></div>
              <div class="pv-timeline">
                <div class="pv-days"><span>Kierowca</span><span>Pn</span><span>Wt</span><span>Śr</span><span>Cz</span><span>Pt</span></div>
                <div class="pv-driver"><b>K-014</b><span class="pv-span pv-span-a">Bydgoszcz – Berlin</span><i></i><i></i></div>
                <div class="pv-driver"><b>K-021</b><i></i><span class="pv-span pv-span-b">Hamburg</span><i></i></div>
                <div class="pv-driver"><b>K-008</b><span class="pv-span pv-span-c">Warszawa – Praga</span><i></i><i></i></div>
                <div class="pv-driver"><b>K-019</b><i></i><i></i><span class="pv-span pv-span-d">Rotterdam</span></div>
              </div>
              <div class="pv-footer"><span>● Przydzielono</span><span>● Dostępność</span><span>● Konflikt</span></div>
            </div>
            <div class="portfolio-showcase-body">
              <span class="portfolio-showcase-category">02 / Logistyka i harmonogramowanie</span>
              <h3>Transport Planner PRO</h3>
              <p>Tygodniowy harmonogram transportów, przydzielanie kierowców, pojazdów i naczep oraz kontrola konfliktów zasobów.</p>
              <div class="portfolio-showcase-tags"><span>Excel</span><span>VBA</span><span>Planowanie</span></div>
            </div>
          </article>

          <article class="portfolio-showcase-card">
            <div class="portfolio-showcase-media portfolio-visual-stock" role="img" aria-label="Koncepcyjny panel magazynu z zestawieniem stanów i progami dostępności produktów">
              <div class="pv-top"><strong>INVENTORY CONTROL</strong><span>STANY MAGAZYNOWE</span></div>
              <div class="pv-stock-stats">
                <div><small>Produkty</small><strong>148</strong></div>
                <div><small>Do zamówienia</small><strong>12</strong></div>
                <div><small>Ruchy</small><strong>86</strong></div>
              </div>
              <div class="pv-stock-table">
                <div class="pv-stock-head"><span>Produkt</span><span>Dostępność</span><span>Stan</span></div>
                <div><span>Artykuł A-024</span><i><b style="width:83%"></b></i><em>OK</em></div>
                <div><span>Artykuł B-018</span><i><b style="width:28%" class="low"></b></i><em class="low">Niski</em></div>
                <div><span>Artykuł C-046</span><i><b style="width:59%"></b></i><em>OK</em></div>
              </div>
            </div>
            <div class="portfolio-showcase-body">
              <span class="portfolio-showcase-category">03 / Magazyn i kontrola stanów</span>
              <h3>Inventory Control PRO</h3>
              <p>Ewidencja produktów, operacje przyjęć i wydań, kontrola stanów minimalnych oraz alerty braków.</p>
              <div class="portfolio-showcase-tags"><span>Excel</span><span>VBA</span><span>Magazyn</span></div>
            </div>
          </article>

          <article class="portfolio-showcase-card">
            <div class="portfolio-showcase-media portfolio-visual-crm" role="img" aria-label="Koncepcyjny podgląd tablicy szans sprzedaży z trzema etapami obsługi klientów">
              <div class="pv-top"><strong>CRM WORKFLOW</strong><span>LEJEK SPRZEDAŻY</span></div>
              <div class="pv-crm-columns">
                <div><strong>Nowe <small>4</small></strong><span>Zapytanie #104</span><span>Zapytanie #109</span></div>
                <div><strong>W trakcie <small>3</small></strong><span>Oferta #078</span><span>Oferta #083</span></div>
                <div><strong>Finalizacja <small>2</small></strong><span>Projekt #056</span><span>Projekt #061</span></div>
              </div>
              <div class="pv-crm-bottom"><span>Kontakty</span><span>Szanse</span><span>Zadania</span></div>
            </div>
            <div class="portfolio-showcase-body">
              <span class="portfolio-showcase-category">04 / Zarządzanie sprzedażą</span>
              <h3>CRM Workflow PRO</h3>
              <p>Baza kontaktów, lejek sprzedażowy, zadania handlowców oraz organizacja pracy z zapytaniami klientów.</p>
              <div class="portfolio-showcase-tags"><span>Excel</span><span>VBA</span><span>CRM</span></div>
            </div>
          </article>
        </div>
        <p class="portfolio-showcase-context">Karty bez odnośników prezentują koncepcje kolejnych projektów. Ich podstrony i rzeczywiste materiały zostaną dodane po ukończeniu realizacji.</p>
      </div>
    </section>
    <section class="portfolio-section">
      <div class="wrap">
        <h2 class="portfolio-heading">Jakie rozwiązania można zbudować w Excelu?</h2>
        <p class="portfolio-subheading">Dobrze zaprojektowany arkusz może pełnić funkcję systemu raportowania, aplikacji operacyjnej lub narzędzia automatyzującego powtarzalne czynności.</p>
        <div class="portfolio-grid">
          <article class="portfolio-card"><span class="symbol">Σ</span><h3>Raporty i KPI</h3><p>Analiza sprzedaży, kosztów, realizacji celów i rentowności z czytelną prezentacją wyników.</p></article>
          <article class="portfolio-card"><span class="symbol">↺</span><h3>Automatyzacje VBA</h3><p>Przetwarzanie plików, uzupełnianie raportów, walidacja danych i powtarzalne procesy uruchamiane przyciskiem.</p></article>
          <article class="portfolio-card"><span class="symbol">⇄</span><h3>Import i eksport danych</h3><p>Praca z CSV, raportami PDF, tabelami źródłowymi oraz uporządkowanymi danymi wejściowymi.</p></article>
        </div>
      </div>
    </section>
    <section class="portfolio-section">
      <div class="wrap">
        <div class="portfolio-cta">
          <div><h2>Potrzebujesz podobnego narzędzia?</h2><p>Opisz swoje dane, aktualny sposób raportowania i oczekiwany wynik. Sprawdzimy, jak zaprojektować rozwiązanie dopasowane do procesu.</p></div>
          <a href={link('/uslugi/excel-vba/')+'#zapytanie'}>Przejdź do współpracy →</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
