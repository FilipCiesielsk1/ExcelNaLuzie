---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase as link } from '../../../utils/paths.js';
import '../../../styles/portfolio.css';
const site='https://excelnaluzie.pl';
const url=site+'/realizacje/sales-performance-dashboard/';
const schema={
  '@context':'https://schema.org',
  '@graph':[
    {'@type':'WebPage','@id':url+'#page',url,name:'Sales Performance Dashboard PRO — realizacja Excel i VBA',inLanguage:'pl-PL',
      description:'Dashboard sprzedaży w Excelu: 8 KPI, 5 wykresów, filtry regionu i czasu, import CSV, eksport PDF i automatyzacje VBA.',
      isPartOf:{'@id':site+'/#website'}},
    {'@type':'BreadcrumbList',itemListElement:[
      {'@type':'ListItem',position:1,name:'ExcelNaLuzie',item:site+'/'},
      {'@type':'ListItem',position:2,name:'Realizacje',item:site+'/realizacje/'},
      {'@type':'ListItem',position:3,name:'Sales Performance Dashboard PRO',item:url}
    ]}
  ]
};
const kpis=[
  {label:'Przychód netto',value:'46 751,41 zł'},
  {label:'Marża kwotowa',value:'13 304,34 zł'},
  {label:'Marża procentowa',value:'28,46%'},
  {label:'Liczba transakcji',value:'21'}
];
const features=[
  {symbol:'01',title:'Panel KPI',description:'Przychód netto, marża kwotowa i procentowa, liczba transakcji, średnia wartość zamówienia, realizacja celu, zmiana przychodu i najlepszy handlowiec.'},
  {symbol:'02',title:'Wykresy zarządcze',description:'Przychód miesięczny, przychód względem celu, marża miesięczna, ranking regionów oraz dziesięć najważniejszych produktów.'},
  {symbol:'03',title:'Filtry raportu',description:'Wybór roku, miesiąca i regionu pozwala analizować dane z różnych perspektyw, bez ręcznego filtrowania tabel źródłowych.'},
  {symbol:'04',title:'Import CSV',description:'Możliwość dołączenia nowych danych sprzedażowych z pliku tekstowego, z uwzględnieniem pól ujętych w cudzysłowy.'},
  {symbol:'05',title:'Raport PDF',description:'Przygotowanie widoku dashboardu do eksportu, z zachowaniem aktualnego kontekstu analizy.'},
  {symbol:'06',title:'Modułowa budowa VBA',description:'Oddzielne moduły obsługujące funkcje użytkowe, pracę z danymi oraz operacje automatyzujące raportowanie.'}
];
---
<BaseLayout
  title="Dashboard sprzedaży Excel VBA — Sales Performance PRO | ExcelNaLuzie"
  description="Autorska realizacja dashboardu sprzedaży Excel i VBA. 8 KPI, 5 wykresów, analiza regionów, cele sprzedażowe, import CSV i raport PDF. Zobacz projekt."
  canonical="/realizacje/sales-performance-dashboard/"
  navSection="realizacje"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <div class="portfolio-page" data-pagefind-body>
    <section class="portfolio-intro">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Okruszki">
          <a href={link('/')}>ExcelNaLuzie</a><span>›</span>
          <a href={link('/realizacje/')}>Realizacje</a><span>›</span>
          <strong>Sales Performance Dashboard PRO</strong>
        </nav>
        <span class="portfolio-eyebrow">Excel / VBA / Analityka sprzedaży</span>
        <h1>Sales Performance <em>Dashboard PRO</em></h1>
        <p>Autorska aplikacja do monitorowania wyników sprzedaży: wskaźniki KPI, rentowność, realizacja planów, analizy regionalne i obsługa danych CSV w jednym skoroszycie Excel.</p>
        <div class="portfolio-stats">
          <span>7 arkuszy</span>
          <span>8 KPI</span>
          <span>5 wykresów</span>
          <span>2 435 pozycji w tabeli sprzedaży</span>
          <span>Excel + VBA</span>
        </div>
        <div class="portfolio-actions">
          <a class="primary" href="#funkcje">Poznaj funkcjonalność ↓</a>
          <a class="secondary" href={link('/uslugi/excel-vba/')+'#zapytanie'}>Zamów podobny dashboard →</a>
        </div>
      </div>
    </section>
    <section class="portfolio-section">
      <div class="wrap portfolio-feature">
        <div>
          <span class="portfolio-project-kicker">Cel rozwiązania</span>
          <h2>Jedno miejsce do analizy przychodów, marży i realizacji celów</h2>
          <p>Zamiast ręcznego łączenia kilku zestawień raport prezentuje najważniejsze informacje w centralnym panelu, a szczegóły pozostawia w ustrukturyzowanych tabelach źródłowych.</p>
          <ul class="portfolio-points">
            <li>Wybór roku, miesiąca i regionu.</li>
            <li>Porównywanie wyników z odpowiednim wcześniejszym okresem.</li>
            <li>Kontrola sprzedaży i marży w podziale na regiony, handlowców i produkty.</li>
            <li>Osobne tabele transakcji i celów, słowniki oraz model analityczny.</li>
          </ul>
          <p class="portfolio-note">Liczby w podglądzie odpowiadają zapisanemu stanowi skoroszytu dla sierpnia 2026 i regionu Północ.</p>
        </div>
        <div class="portfolio-dashboard" aria-label="Podgląd danych dashboardu">
          <div class="portfolio-dashboard-top"><strong>SALES PERFORMANCE DASHBOARD PRO</strong><small>ANALITYKA SPRZEDAŻY · PLN</small></div>
          <div class="portfolio-dashboard-filters"><span>2026</span><span>08 Sierpień</span><span>Północ</span></div>
          <div class="portfolio-kpis">
            {kpis.map(kpi=>(
              <div class="portfolio-kpi"><small>{kpi.label.toUpperCase()}</small><strong>{kpi.value}</strong></div>
            ))}
          </div>
          <div class="portfolio-chart-preview">
            <div><h3>Przychód miesięczny</h3><div class="portfolio-columns" aria-hidden="true">
              <span style="--bar:54%"></span><span style="--bar:77%"></span><span style="--bar:68%"></span><span style="--bar:93%"></span><span style="--bar:62%"></span><span style="--bar:82%"></span><span style="--bar:100%"></span>
            </div></div>
            <div><h3>Regiony</h3><div class="portfolio-rank">
              <div><span>Północ</span><b style="--bar:72%"></b></div>
              <div><span>Południe</span><b style="--bar:95%"></b></div>
              <div><span>Centrum</span><b style="--bar:64%"></b></div>
              <div><span>Wschód</span><b style="--bar:45%"></b></div>
            </div></div>
          </div>
          <small class="portfolio-preview-note">Wizualny podgląd układu raportu. Wykresy są ilustracją układu; wartości kart pochodzą ze skoroszytu.</small>
        </div>
      </div>
    </section>
    <section class="portfolio-section" id="funkcje">
      <div class="wrap">
        <span class="portfolio-eyebrow">Zakres projektu</span>
        <h2 class="portfolio-heading">Co potrafi aplikacja?</h2>
        <p class="portfolio-subheading">Oprócz prezentacji wyników skoroszyt zawiera zaplecze danych i zestaw działań dostępnych z poziomu interfejsu Excel.</p>
        <div class="portfolio-grid">
          {features.map(item=>(
            <article class="portfolio-card"><span class="symbol">{item.symbol}</span><h3>{item.title}</h3><p>{item.description}</p></article>
          ))}
        </div>
      </div>
    </section>
    <section class="portfolio-section">
      <div class="wrap portfolio-details">
        <div>
          <span class="portfolio-eyebrow">Organizacja danych</span>
          <h2 class="portfolio-heading" style="margin-top:10px;">Struktura skoroszytu</h2>
          <p class="portfolio-subheading">Siedem arkuszy rozdziela interfejs, dane operacyjne i konfigurację. Dzięki temu dashboard nie wymaga ręcznego układania raportów po każdej aktualizacji danych.</p>
          <div class="portfolio-table-scroll">
            <table class="portfolio-table">
              <thead><tr><th>Arkusz</th><th>Przeznaczenie</th></tr></thead>
              <tbody>
                <tr><td>DASHBOARD</td><td>Wskaźniki, filtry i wykresy</td></tr>
                <tr><td>SPRZEDAŻ</td><td>Rejestr transakcji i obliczenia</td></tr>
                <tr><td>CELE</td><td>Plany miesięczne i regionalne</td></tr>
                <tr><td>SŁOWNIKI</td><td>Regiony, produkty, handlowcy i klienci</td></tr>
                <tr><td>ANALIZA</td><td>Model pomocniczy do KPI i wykresów</td></tr>
                <tr><td>USTAWIENIA</td><td>Konfiguracja aplikacji</td></tr>
                <tr><td>INSTRUKCJA</td><td>Obsługa i diagnostyka</td></tr>
              </tbody>
            </table>
          </div>
        </div>
        <div>
          <span class="portfolio-eyebrow">Przepływ pracy</span>
          <h2 class="portfolio-heading" style="margin-top:10px;">Od pliku CSV do raportu</h2>
          <div class="portfolio-steps">
            <div class="portfolio-step"><b>01</b><div><strong>Wprowadzenie danych</strong><p>Dane z tabeli SPRZEDAŻ lub nowy plik CSV, zgodny ze strukturą importu.</p></div></div>
            <div class="portfolio-step"><b>02</b><div><strong>Przetwarzanie i agregacja</strong><p>Przeliczenie wartości sprzedaży, kosztów, marży i realizacji celów.</p></div></div>
            <div class="portfolio-step"><b>03</b><div><strong>Analiza wyników</strong><p>Zmiana filtrów roku, miesiąca i regionu oraz odczyt wskaźników.</p></div></div>
            <div class="portfolio-step"><b>04</b><div><strong>Udostępnienie raportu</strong><p>Eksport podsumowania do formatu PDF.</p></div></div>
          </div>
        </div>
      </div>
    </section>
    <section class="portfolio-section">
      <div class="wrap">
        <span class="portfolio-eyebrow">Dane wejściowe</span>
        <h2 class="portfolio-heading" style="margin-top:10px;">Przykład pliku CSV do importu</h2>
        <p class="portfolio-subheading">Format wejściowy obejmuje 12 kolumn, od identyfikatora transakcji i daty po rabat i koszt jednostkowy. Plik zawiera także pole wielowierszowe i separator wewnątrz cudzysłowu, co ułatwia sprawdzenie parsera.</p>
        <div class="portfolio-actions" style="margin-top:0;">
          <a class="secondary" href={link('/downloads/realizacje/sales-performance-import.csv')} download>Pobierz przykładowy CSV ↓</a>
        </div>
        <p class="portfolio-note">CSV jest plikiem tekstowym UTF-8. Obsługa importu odbywa się w skoroszycie Excel z aktywnymi makrami VBA. Makra włączaj wyłącznie w zaufanym pliku.</p>
      </div>
    </section>
    <section class="portfolio-section">
      <div class="wrap">
        <div class="portfolio-cta">
          <div><h2>Chcesz podobny dashboard dla swojej firmy?</h2><p>Możemy omówić potrzebne KPI, źródła danych, pliki wejściowe i sposób prezentacji wyników. Opisz, co raportujesz obecnie i czego oczekujesz od docelowego rozwiązania.</p></div>
          <a href={link('/uslugi/excel-vba/')+'#zapytanie'}>Zapytaj o rozwiązanie →</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
