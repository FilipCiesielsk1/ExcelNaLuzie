---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase as link } from '../../../utils/paths.js';
import '../../../styles/portfolio.css';

const root='/media/realizacje/sales-performance-dashboard/';
const media=(name)=>link(root+name);
const demoFilename='Sales_Performance_Dashboard_demo.xlsm';
const demoDownload='/downloads/realizacje/'+demoFilename;
const demoFileAvailable=existsSync(join(process.cwd(),'public','downloads','realizacje',demoFilename));
const site='https://excelnaluzie.pl';
const url=site+'/realizacje/sales-performance-dashboard/';
const schema={
  '@context':'https://schema.org',
  '@graph':[
    {'@type':'WebPage','@id':url+'#page',url,name:'Sales Performance Dashboard PRO — realizacja Excel i VBA',inLanguage:'pl-PL',
      description:'Zobacz prawdziwe ekrany i nagrania dashboardu sprzedaży w Excelu: KPI, pięć wykresów, filtry regionów, import CSV i eksport PDF.',
      primaryImageOfPage:{'@type':'ImageObject',url:site+root+'01_dashboard_glowny.webp'},
      isPartOf:{'@id':site+'/#website'}},
    {'@type':'BreadcrumbList',itemListElement:[
      {'@type':'ListItem',position:1,name:'ExcelNaLuzie',item:site+'/'},
      {'@type':'ListItem',position:2,name:'Realizacje',item:site+'/realizacje/'},
      {'@type':'ListItem',position:3,name:'Sales Performance Dashboard PRO',item:url}
    ]}
  ]
};
const showcases=[
 {file:'02_dashboard_filtry.webp',alt:'Panel sterowania z przyciskami odświeżania, importu CSV, eksportu PDF i filtrami roku, miesiąca oraz regionu',label:'Filtry i panel sterowania',text:'Zmiana roku, okresu i regionu w jednym miejscu.',width:1768,height:206,wide:true},
 {file:'03_dashboard_wykresy.webp',alt:'Pięć wykresów Excel: przychód miesięczny, realizacja celu, marża, ranking regionów i TOP 10 produktów',label:'Pięć wykresów',text:'Trendy, cele, marża, regiony i produkty.',width:1778,height:439,wide:true},
 {file:'04_dane_sprzedazy.webp',alt:'Arkusz SPRZEDAŻ z tabelą transakcji, cenami, rabatami, kosztami i formułami marży',label:'Baza sprzedaży',text:'Tabela transakcyjna z danymi wejściowymi i formułami.',width:1920,height:1032},
 {file:'05_cele_sprzedazowe.webp',alt:'Arkusz CELE z planami przychodowymi i marżowymi w rozbiciu na lata, miesiące i regiony',label:'Plany sprzedażowe',text:'Cele w podziale na miesiące i regiony.',width:1920,height:1032},
 {file:'06_import_csv.webp',alt:'Komunikat Microsoft Excel po imporcie CSV: dwa rekordy zaimportowane, zero duplikatów i błędów',label:'Import CSV',text:'Rezultat działania mechanizmu importu.',width:1919,height:1031},
 {file:'07_raport_pdf.webp',alt:'Otwarty w przeglądarce raport PDF wyeksportowany z dashboardu sprzedaży',label:'Eksport PDF',text:'Gotowe zestawienie przeznaczone do udostępnienia.',width:1920,height:1032}
];
const recordings=[
 {file:'01_zmiana_miesiaca.webm',title:'Zmiana miesiąca',description:'Zmiana okresu raportowania i aktualizacja widocznych wyników.',poster:'01_dashboard_glowny.webp'},
 {file:'02_zmiana_regionu.webm',title:'Zmiana regionu',description:'Wybór innego regionu i porównanie wskaźników.',poster:'01_dashboard_glowny.webp'},
 {file:'03_import_csv.webm',title:'Import danych CSV',description:'Wczytanie dodatkowych transakcji i komunikat o rezultacie.',poster:'06_import_csv.webp'},
 {file:'04_eksport_pdf.webm',title:'Eksport raportu PDF',description:'Przygotowanie i otwarcie gotowego raportu.',poster:'07_raport_pdf.webp'}
];
const features=[
  {symbol:'01',title:'Panel KPI',description:'Przychód netto, marża kwotowa i procentowa, liczba i średnia wartość transakcji, realizacja celu, dynamika przychodu i najlepszy handlowiec.'},
  {symbol:'02',title:'Wykresy zarządcze',description:'Przychód miesięczny, przychód względem celu, marża miesięczna, ranking regionów oraz TOP 10 produktów.'},
  {symbol:'03',title:'Filtry raportu',description:'Wybór roku, miesiąca i regionu pozwala analizować dane z różnych perspektyw.'},
  {symbol:'04',title:'Import CSV',description:'Dodawanie transakcji z pliku tekstowego z kontrolą liczby zaimportowanych rekordów, duplikatów i błędów.'},
  {symbol:'05',title:'Raport PDF',description:'Eksport bieżącego zestawienia bez ręcznego kopiowania wykresów i wskaźników.'},
  {symbol:'06',title:'Automatyzacja VBA',description:'Przyciski do odświeżania, nawigacji, importu danych i tworzenia raportu.'}
];
---
<BaseLayout
  title="Dashboard sprzedaży Excel VBA — Sales Performance PRO | ExcelNaLuzie"
  description="Zobacz rzeczywiste zrzuty ekranu i cztery nagrania działania Sales Performance Dashboard PRO. 8 KPI, 5 wykresów, filtry, import CSV i PDF."
  canonical="/realizacje/sales-performance-dashboard/"
  navSection="realizacje"
  image={root+'01_dashboard_glowny.webp'}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <div class="portfolio-page" data-pagefind-body>
    <section class="portfolio-intro">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Okruszki">
          <a href={link('/')}>ExcelNaLuzie</a><span>›</span>
          <a href={link('/realizacje/')}>Realizacje</a><span>›</span>
          <strong>Sales Performance Dashboard PRO</strong>
        </nav>
        <span class="portfolio-eyebrow">Excel / VBA / Analityka sprzedaży</span>
        <h1>Sales Performance <em>Dashboard PRO</em></h1>
        <p>Autorska aplikacja do monitorowania wyników sprzedaży: wskaźniki KPI, rentowność, realizacja planów, analizy regionalne i import danych CSV w jednym skoroszycie.</p>
        <div class="portfolio-stats">
          <span>7 arkuszy</span>
          <span>8 KPI</span>
          <span>5 wykresów</span>
          <span>2 435 pozycji sprzedaży</span>
          <span>Excel + VBA</span>
        </div>
        <p class="portfolio-data-disclaimer" role="note"><strong>Informacja o danych:</strong> Wszystkie dane wykorzystane w tej realizacji są demonstracyjne. Nazwy firm i klientów, transakcje oraz prezentowane wyniki służą wyłącznie pokazaniu możliwości aplikacji.</p>
        <div class="portfolio-actions">
          <a class="primary" href="#zobacz-dashboard">Zobacz aplikację ↓</a>
          {demoFileAvailable && <a class="secondary" href="#demo">Pobierz demo ↓</a>}
          <a class="secondary" href={link('/uslugi/excel-vba/')+'#zapytanie'}>Zamów podobny dashboard →</a>
        </div>
      </div>
    </section>

    <section class="portfolio-section portfolio-media-section" id="zobacz-dashboard">
      <div class="wrap">
        <span class="portfolio-eyebrow">Rzeczywisty widok aplikacji</span>
        <h2 class="portfolio-heading">Tak wygląda dashboard w Excelu</h2>
        <p class="portfolio-subheading">W jednym ekranie: osiem KPI, pięć wykresów i szybki dostęp do importu danych oraz eksportu raportu. Kliknij obraz, aby powiększyć.</p>
        <figure class="portfolio-hero-screen">
          <button type="button" class="portfolio-media-open" data-portfolio-open data-image={media('01_dashboard_glowny.webp')} data-alt="Pełny widok Sales Performance Dashboard PRO w Excelu z ośmioma KPI, pięcioma wykresami, filtrami i przyciskami" data-title="Dashboard — widok główny" aria-label="Powiększ zrzut całego dashboardu">
            <img src={media('01_dashboard_glowny.webp')} width="1920" height="1032" alt="Pełny ekran Excel Sales Performance Dashboard PRO: filtry roku 2026, sierpnia i regionu Północ, KPI, pięć wykresów i przyciski VBA" fetchpriority="high" decoding="async"/>
            <span aria-hidden="true" class="portfolio-media-zoom">↗ Powiększ</span>
          </button>
          <figcaption>Główny ekran aplikacji w Microsoft Excel.</figcaption>
        </figure>
      </div>
    </section>

    <section class="portfolio-section" id="nagrania">
      <div class="wrap">
        <span class="portfolio-eyebrow">Zobacz funkcje w akcji</span>
        <h2 class="portfolio-heading">Cztery krótkie nagrania działania</h2>
        <p class="portfolio-subheading">Rzeczywiste nagrania z aplikacji: zmiana filtrów, import CSV i eksport PDF. Uruchom wybrany film przyciskiem odtwarzania; nagrania są bez dźwięku.</p>
        <div class="portfolio-video-grid">
          {recordings.map((clip,index)=>(
            <figure class="portfolio-video-card">
              <div class="portfolio-video-frame">
                <video
                  controls
                  playsinline
                  muted
                  loop
                  preload="none"
                  poster={media(clip.poster)}
                  aria-label={'Nagranie '+(index+1)+': '+clip.title}
                >
                  <source src={media(clip.file)} type="video/webm"/>
                  Twoja przeglądarka nie obsługuje wideo WebM.
                  <a href={media(clip.file)}>Otwórz nagranie</a>
                </video>
              </div>
              <figcaption>
                <strong><span>{String(index+1).padStart(2,'0')}</span> {clip.title}</strong>
                <p>{clip.description}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="portfolio-section" id="galeria">
      <div class="wrap">
        <span class="portfolio-eyebrow">Galeria aplikacji</span>
        <h2 class="portfolio-heading">Zajrzyj do środka skoroszytu</h2>
        <p class="portfolio-subheading">Od filtrów i wykresów po transakcje, cele, import danych i raport PDF.</p>
        <div class="portfolio-screenshot-grid">
          {showcases.map((shot)=>(
            <figure class:list={['portfolio-shot-card',{wide:shot.wide}]}>
              <button
                type="button"
                class="portfolio-media-open"
                data-portfolio-open
                data-image={media(shot.file)}
                data-alt={shot.alt}
                data-title={shot.label}
                aria-label={'Powiększ obraz: '+shot.label}
              >
                <img src={media(shot.file)} width={shot.width} height={shot.height} loading="lazy" decoding="async" alt={shot.alt}/>
                <span aria-hidden="true" class="portfolio-media-zoom">↗ Powiększ</span>
              </button>
              <figcaption><strong>{shot.label}</strong><span>{shot.text}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="portfolio-section" id="funkcje">
      <div class="wrap">
        <span class="portfolio-eyebrow">Zakres projektu</span>
        <h2 class="portfolio-heading">Co potrafi aplikacja?</h2>
        <p class="portfolio-subheading">Oprócz prezentacji wyników skoroszyt ma zaplecze danych i zestaw działań dostępnych z poziomu interfejsu Excel.</p>
        <div class="portfolio-grid">
          {features.map(item=>(
            <article class="portfolio-card"><span class="symbol">{item.symbol}</span><h3>{item.title}</h3><p>{item.description}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="portfolio-section">
      <div class="wrap portfolio-details">
        <div>
          <span class="portfolio-eyebrow">Organizacja danych</span>
          <h2 class="portfolio-heading" style="margin-top:10px;">Struktura skoroszytu</h2>
          <p class="portfolio-subheading">Siedem głównych arkuszy rozdziela interfejs, dane operacyjne i konfigurację.</p>
          <div class="portfolio-table-scroll">
            <table class="portfolio-table">
              <thead><tr><th>Arkusz</th><th>Przeznaczenie</th></tr></thead>
              <tbody>
                <tr><td>DASHBOARD</td><td>Wskaźniki, filtry i wykresy</td></tr>
                <tr><td>SPRZEDAŻ</td><td>Rejestr transakcji i obliczenia</td></tr>
                <tr><td>CELE</td><td>Plany miesięczne i regionalne</td></tr>
                <tr><td>SŁOWNIKI</td><td>Regiony, produkty, handlowcy i klienci</td></tr>
                <tr><td>ANALIZA</td><td>Zaplecze obliczeniowe KPI i wykresów</td></tr>
                <tr><td>USTAWIENIA</td><td>Konfiguracja aplikacji</td></tr>
                <tr><td>INSTRUKCJA</td><td>Obsługa i diagnostyka</td></tr>
              </tbody>
            </table>
          </div>
        </div>
        <div>
          <span class="portfolio-eyebrow">Przepływ pracy</span>
          <h2 class="portfolio-heading" style="margin-top:10px;">Od pliku CSV do raportu</h2>
          <div class="portfolio-steps">
            <div class="portfolio-step"><b>01</b><div><strong>Wprowadzenie danych</strong><p>Dane z tabeli SPRZEDAŻ lub pliku CSV zgodnego ze strukturą importu.</p></div></div>
            <div class="portfolio-step"><b>02</b><div><strong>Przetwarzanie</strong><p>Przeliczenie wartości sprzedaży, kosztów, marży i realizacji celów.</p></div></div>
            <div class="portfolio-step"><b>03</b><div><strong>Analiza wyników</strong><p>Zmiana filtrów roku, miesiąca i regionu oraz odczyt wskaźników.</p></div></div>
            <div class="portfolio-step"><b>04</b><div><strong>Raport PDF</strong><p>Eksport podsumowania w czytelnym układzie.</p></div></div>
          </div>
        </div>
      </div>
    </section>

    {demoFileAvailable && (
      <section class="portfolio-section" id="demo" aria-labelledby="dashboard-demo-heading">
        <div class="wrap">
          <span class="portfolio-eyebrow">Wersja demonstracyjna</span>
          <h2 class="portfolio-heading" id="dashboard-demo-heading">Pobierz Sales Performance Dashboard demo</h2>
          <p class="portfolio-subheading">Sprawdź aplikację samodzielnie w programie Microsoft Excel. Plik zawiera przykładowe dane, panel wskaźników i funkcje oparte na VBA.</p>
          <div class="portfolio-actions">
            <a class="primary" href={link(demoDownload)} download={demoFilename} type="application/vnd.ms-excel.sheet.macroEnabled.12" aria-label="Pobierz wersję demo dashboardu, plik XLSM">Pobierz wersję demo (.xlsm) ↓</a>
          </div>
          <p class="portfolio-note"><strong>Ważne:</strong> plik XLSM zawiera makra VBA. Otwórz go w klasycznym Microsoft Excel na komputerze. Program Excel może blokować makra pobrane z Internetu — włączaj je tylko po zweryfikowaniu źródła i zawartości pliku.</p>
        </div>
      </section>
    )}

    <section class="portfolio-section">
      <div class="wrap">
        <span class="portfolio-eyebrow">Dane wejściowe</span>
        <h2 class="portfolio-heading" style="margin-top:10px;">Przykładowy CSV do importu</h2>
        <p class="portfolio-subheading">Format wejściowy obejmuje 12 kolumn, od identyfikatora transakcji i daty po rabat i koszt jednostkowy. Plik zawiera również pole wielowierszowe oraz separator wewnątrz cudzysłowu, dzięki czemu pozwala przetestować parser.</p>
        <div class="portfolio-actions" style="margin-top:0;">
          <a class="secondary" href={link('/downloads/realizacje/sales-performance-import.csv')} download>Pobierz przykładowy CSV ↓</a>
        </div>
        <p class="portfolio-note">Plik CSV można odczytać tekstowo lub zaimportować w Excelu. Makra należy uruchamiać wyłącznie w zaufanych plikach.</p>
      </div>
    </section>
    <section class="portfolio-section">
      <div class="wrap">
        <div class="portfolio-cta">
          <div><h2>Chcesz podobny dashboard dla swojej firmy?</h2><p>Możemy omówić potrzebne KPI, źródła danych, pliki wejściowe i sposób prezentacji wyników. Opisz, co raportujesz obecnie i czego oczekujesz od docelowego rozwiązania.</p></div>
          <a href={link('/uslugi/excel-vba/')+'#zapytanie'}>Zapytaj o rozwiązanie →</a>
        </div>
      </div>
    </section>
  </div>

  <dialog class="portfolio-lightbox" data-portfolio-lightbox aria-label="Powiększone zdjęcie aplikacji">
    <div class="portfolio-lightbox-head">
      <strong data-portfolio-lightbox-title></strong>
      <button type="button" data-portfolio-close aria-label="Zamknij powiększenie">Zamknij ×</button>
    </div>
    <img data-portfolio-lightbox-image alt=""/>
    <p class="portfolio-lightbox-tip">Naciśnij Esc lub Zamknij, aby wrócić do galerii.</p>
  </dialog>
  <script>
    const dialog=document.querySelector('[data-portfolio-lightbox]');
    const photo=dialog?.querySelector('[data-portfolio-lightbox-image]');
    const title=dialog?.querySelector('[data-portfolio-lightbox-title]');
    if(dialog && photo && title){
      document.querySelectorAll('[data-portfolio-open]').forEach(button=>{
        button.addEventListener('click',()=>{
          photo.src=button.dataset.image;
          photo.alt=button.dataset.alt||'Zrzut ekranu aplikacji Excel';
          title.textContent=button.dataset.title||'Zrzut aplikacji';
          dialog.showModal();
        });
      });
      dialog.querySelector('[data-portfolio-close]')?.addEventListener('click',()=>dialog.close());
      dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close();});
      dialog.addEventListener('close',()=>{photo.removeAttribute('src');});
    }
  </script>
</BaseLayout>
