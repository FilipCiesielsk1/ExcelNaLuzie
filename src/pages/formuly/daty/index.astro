---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase as link } from '../../../utils/paths.js';
import { articleClusters } from '../../../data/articleClusters.js';

const cluster = articleClusters['formuly/daty'];
const articles = cluster.articles;
---

<BaseLayout
  title={`Daty i czas w Excelu — ${articles.length} praktycznych poradników | ExcelNaLuzie`}
  description="Daty w Excelu bez zgadywania: różnice między datami, miesiące, tygodnie, pierwszy i ostatni dzień miesiąca oraz dni robocze."
>
  <section class="hub-hero hub-formulas">
    <div class="wrap hub-hero-grid">
      <div>
        <nav class="hub-breadcrumbs"><a href={link("/")}>ExcelNaLuzie</a><span>›</span><a href={link("/formuly/")}>Formuły</a><span>›</span><strong>Daty i czas</strong></nav>
        <span class="hub-kicker">Klaster: Daty i czas</span>
        <h1>Daty bez kombinowania.<br/><em>Od dni do tygodni.</em></h1>
        <p>Obliczaj różnice, dni robocze, miesiące, numery tygodni i granice okresów za pomocą gotowych formuł.</p>
        <div class="hub-actions">
          <a class="hub-primary" href="#poradniki">Zobacz poradniki <span>↓</span></a>
          <a class="hub-secondary" href={link("/formuly/")}>Wszystkie formuły</a>
        </div>
      </div>
      <div class="formula-stack" aria-hidden="true">
        <div class="formula-stack-card one"><span>Różnica</span><code>=B2-A2</code></div>
        <div class="formula-stack-card two"><span>Tydzień ISO</span><code>=NUM.TYG(A2;21)</code></div>
        <div class="formula-stack-card three"><span>Dni robocze</span><code>=DNI.ROBOCZE(A2;B2)</code></div>
      </div>
    </div>
  </section>

  <section class="hub-section" id="poradniki">
    <div class="wrap">
      <div class="hub-section-head">
        <div><span class="section-kicker">{articles.length} poradników</span><h2>Co chcesz policzyć?</h2></div>
        <p>Wybierz rezultat: liczbę dni, pełne miesiące, tydzień, początek okresu albo termin po przesunięciu daty.</p>
      </div>
      <div class="hub-article-list">
        {articles.map((item,index) => (
          <a href={link('/poradniki/' + item.slug + '/')}>
            <span class="hub-list-num">{String(index+1).padStart(2,'0')}</span>
            <div><small>Daty i czas</small><strong>{item.title}</strong></div>
            <code>{item.label}</code>
            <b>→</b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="hub-section hub-section-alt">
    <div class="wrap">
      <div class="hub-section-head">
        <div><span class="section-kicker">Najważniejsza zasada</span><h2>Excel przechowuje daty jako liczby</h2></div>
        <p>Dlatego daty można odejmować i przesuwać. Specjalne funkcje przydają się wtedy, gdy znaczenie ma kalendarz: miesiące, tygodnie, weekendy lub święta.</p>
      </div>
      <div class="reference-steps">
        <div><span>01</span><strong>Dni</strong><p>Do prostych różnic często wystarczy zwykłe odejmowanie dwóch dat.</p></div>
        <div><span>02</span><strong>Miesiące i tygodnie</strong><p>Używaj funkcji kalendarzowych zamiast przyjmować, że każdy miesiąc ma 30 dni.</p></div>
        <div><span>03</span><strong>Dni robocze</strong><p>DNI.ROBOCZE potrafi wykluczyć weekendy oraz wskazaną listę świąt.</p></div>
      </div>
    </div>
  </section>
</BaseLayout>