---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase as link } from '../utils/paths.js';
import { articleClusters } from '../data/articleClusters.js';
import { functionCatalog } from '../data/functionCatalog.js';
import { templateCatalog } from '../data/templateCatalog.js';
import { toolRelationships } from '../data/contentRelationships.js';

const clusters = Object.values(articleClusters);
const articleCount = clusters.reduce((sum, cluster) => sum + cluster.articles.length, 0);
const functionCount = functionCatalog.length;
const toolCount = Object.keys(toolRelationships).length;

const functionSlugs = [
  'jezeli',
  'xwyszukaj',
  'filtruj',
  'suma-warunkow',
  'licz-warunki',
  'tekst-po',
  'data-roznica',
  'sekwencja'
];

const featuredGuides = [
  { title: 'Jak porównać dwie tabele Excel?', description: 'Znajdź zmienione wartości, brakujące rekordy i duplikaty po ID.', href: '/poradniki/jak-porownac-dwie-tabele-excel/' },
  { title: 'Jak zrobić tabelę przestawną?', description: 'Przejdź od danych źródłowych do raportu z wierszami, kolumnami i sumami.', href: '/poradniki/jak-zrobic-tabele-przestawna-w-excelu/' },
  { title: 'WYSZUKAJ.PIONOWO na X.WYSZUKAJ', description: 'Przepisz starszą formułę na czytelniejsze wyszukiwanie dokładne.', href: '/poradniki/wyszukaj-pionowo-na-xwyszukaj/' },
  { title: 'Jak naprawić błędy formuł?', description: 'Sprawdź nawiasy, średniki, cudzysłowy i typowe błędy Excela.', href: '/poradniki/jak-sprawdzic-bledy-w-formule-excel/' }
];

const popularFunctions = functionSlugs
  .map((slug) => functionCatalog.find((item) => item.slug === slug))
  .filter(Boolean);

const toolHighlights = [
  {
    title: 'Generator tabel przestawnych',
    href: '/narzedzia/generator-tabel-przestawnych/',
    icon: 'Σ↔',
    text: 'Zbuduj przekrój danych z wierszami, kolumnami i sumami.'
  },
  {
    title: 'Porównywarka tabel Excel',
    href: '/narzedzia/porownywarka-tabel/',
    icon: 'A↔B',
    text: 'Znajdź brakujące rekordy, zmiany i duplikaty w dwóch tabelach.'
  },
  {
    title: 'Analizator formuł',
    href: '/narzedzia/analizator-formul/',
    icon: 'fx',
    text: 'Sprawdź nawiasy, separatory i zagnieżdżenia funkcji.'
  },
  {
    title: 'WYSZUKAJ.PIONOWO → X.WYSZUKAJ',
    href: '/narzedzia/konwerter-wyszukaj-pionowo/',
    icon: '↗',
    text: 'Przepisz dokładne wyszukiwanie na nową formułę.'
  },
  {
    title: 'Generator JEŻELI',
    href: '/narzedzia/generator-jezeli/',
    icon: 'IF',
    text: 'Ułóż warunek i skopiuj gotową formułę.'
  },
  {
    title: 'Generator X.WYSZUKAJ',
    href: '/narzedzia/generator-xwyszukaj/',
    icon: 'X',
    text: 'Zbuduj wyszukiwanie bez pamiętania składni.'
  },
  {
    title: 'Generator FILTRUJ',
    href: '/narzedzia/generator-filtruj/',
    icon: '⇢',
    text: 'Połącz kilka warunków przez ORAZ albo LUB.'
  },
  {
    title: 'Generator SUMA.WARUNKÓW',
    href: '/narzedzia/generator-suma-warunkow/',
    icon: 'Σ',
    text: 'Zsumuj tylko rekordy spełniające kryteria.'
  },
  {
    title: 'Kalkulator dat',
    href: '/narzedzia/kalkulator-dat/',
    icon: '31',
    text: 'Policz różnicę i dni robocze między datami.'
  },
  {
    title: 'Tłumacz funkcji PL ↔ EN',
    href: '/narzedzia/tlumacz-funkcji-excel/',
    icon: 'PL',
    text: 'Znajdź odpowiednik w słowniku 150+ funkcji.'
  }
];
---

<BaseLayout
  title="ExcelNaLuzie — poradniki, funkcje i narzędzia do Excela"
  description="Znajdź rozwiązanie problemu w Excelu, sprawdź polską składnię funkcji albo wygeneruj gotową formułę. Praktycznie i bez zbędnego gadania."
>
  <section class="home-hero">
    <div class="wrap home-hero-grid">
      <div class="home-hero-copy">
        <div class="eyebrow"><span></span> Excel po polsku, konkretnie</div>
        <h1>Masz problem w Excelu?<br/><em>Znajdź rozwiązanie.</em></h1>
        <p>
          Poradniki, polskie funkcje i generatory formuł w jednym miejscu.
          Zamiast przekopywać fora — wpisz problem i przejdź prosto do rozwiązania.
        </p>

        <button class="home-search-launch" type="button" data-global-search-open>
          <span class="home-search-icon" aria-hidden="true">⌕</span>
          <span class="home-search-copy">
            <strong>Szukaj w całym ExcelNaLuzie</strong>
            <small>np. X.WYSZUKAJ, daty, JEŻELI, tekst po znaku...</small>
          </span>
          <kbd>Ctrl K</kbd>
        </button>

        <div class="home-hero-links">
          <span>Popularne:</span>
          <a href={link("/poradniki/xwyszukaj-podstawy/")}>X.WYSZUKAJ</a>
          <a href={link("/poradniki/jezeli-podstawy/")}>JEŻELI</a>
          <a href={link("/poradniki/roznica-miedzy-datami/")}>daty</a>
          <a href={link("/poradniki/filtruj-podstawy/")}>FILTRUJ</a>
        </div>
      </div>

      <div class="home-hero-panel">
        <div class="home-panel-top">
          <span>ExcelNaLuzie w liczbach</span>
          <b>Aktualizowane na bieżąco</b>
        </div>
        <div class="home-stats">
          <div><strong>{articleCount}</strong><span>poradników</span></div>
          <div><strong>{functionCount}</strong><span>funkcji</span></div>
          <div><strong>{toolCount}</strong><span>narzędzi</span></div>
          <div><strong>{clusters.length}</strong><span>klastrów</span></div>
        </div>
        <div class="home-formula-preview">
          <span>Przykład</span>
          <code>=X.WYSZUKAJ(F2;A2:A100;C2:C100;"Brak")</code>
          <div>
            <i>1</i><p><strong>Znajdź poradnik</strong><small>Zrozum rozwiązanie.</small></p>
          </div>
          <div>
            <i>2</i><p><strong>Sprawdź funkcję</strong><small>Zobacz składnię i argumenty.</small></p>
          </div>
          <div>
            <i>3</i><p><strong>Użyj generatora</strong><small>Skopiuj gotową formułę.</small></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="service-home-strip" aria-label="Indywidualne rozwiązania Excel i VBA">
    <div class="wrap service-home-strip-inner">
      <div>
        <span class="section-kicker">Gdy gotowa formuła nie wystarczy</span>
        <h2>Automatyzacje Excel i VBA dopasowane do Twojego procesu</h2>
        <p>Makra, raporty, łączenie plików i naprawa istniejących skoroszytów. Zgłoś zapotrzebowanie na przyszły projekt.</p>
      </div>
      <a href={link("/uslugi/excel-vba/")}>Opisz swój problem <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="home-paths-section">
    <div class="wrap">
      <div class="home-section-head compact">
        <div>
          <span class="section-kicker">Od czego zaczynasz?</span>
          <h2>Wybierz najkrótszą drogę</h2>
        </div>
      </div>

      <div class="home-paths-grid">
        <a class="home-path-card problem" href={link("/formuly/")}>
          <span class="home-path-number">01</span>
          <div class="home-path-icon">?</div>
          <span class="home-path-label">Mam problem</span>
          <h3>Znajdź gotowe rozwiązanie</h3>
          <p>{articleCount} poradników opartych na konkretnych problemach: tekst, daty, wyszukiwanie, logika i więcej.</p>
          <b>Przejdź do poradników →</b>
        </a>

        <a class="home-path-card function" href={link("/funkcje/")}>
          <span class="home-path-number">02</span>
          <div class="home-path-icon">ƒx</div>
          <span class="home-path-label">Szukam funkcji</span>
          <h3>Sprawdź składnię i przykład</h3>
          <p>{functionCount} opisanych funkcji polskiego Excela z argumentami, wersjami i praktycznym zastosowaniem.</p>
          <b>Przejdź do funkcji →</b>
        </a>

        <a class="home-path-card tool" href={link("/narzedzia/")}>
          <span class="home-path-number">03</span>
          <div class="home-path-icon">⚙</div>
          <span class="home-path-label">Chcę gotowca</span>
          <h3>Wygeneruj formułę</h3>
          <p>{toolCount} generatorów i kalkulatorów. Podajesz dane, kopiujesz wynik i wracasz do arkusza.</p>
          <b>Przejdź do narzędzi →</b>
        </a>
      </div>

      <div class="home-secondary-links">
        <a href={link("/vba/")}><span>&lt;/&gt;</span><strong>VBA</strong><small>Automatyzacja i makra</small><b>→</b></a>
        <a href={link("/szablony/")}><span>XLSX</span><strong>Szablony</strong><small>Gotowe pliki do pobrania</small><b>→</b></a>
      </div>
    </div>
  </section>

  <section class="home-clusters-section">
    <div class="wrap">
      <div class="home-section-head">
        <div>
          <span class="section-kicker">{articleCount} poradników w {clusters.length} tematach</span>
          <h2>Wybierz obszar Excela</h2>
        </div>
        <a class="section-link" href={link("/formuly/")}>Wszystkie poradniki <span>→</span></a>
      </div>

      <div class="home-cluster-grid">
        {clusters.map((cluster, index) => (
          <a class="home-cluster-card" href={link(cluster.hub)}>
            <span class="home-cluster-index">{String(index + 1).padStart(2,'0')}</span>
            <div class="home-cluster-symbol">
              {['Aa','⌕','✓','Σ','↯','31','▦'][index] ?? 'ƒx'}
            </div>
            <h3>{cluster.title}</h3>
            <p>{cluster.articles.slice(0,3).map((article) => article.label).join(' · ')}</p>
            <span>{cluster.articles.length} poradników <b>→</b></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-featured-guides" aria-labelledby="home-guides-title">
    <div class="wrap">
      <div class="home-section-head">
        <div>
          <span class="section-kicker">Praktyczne instrukcje krok po kroku</span>
          <h2 id="home-guides-title">Rozwiąż konkretny problem w Excelu</h2>
        </div>
        <a class="section-link" href={link('/formuly/')}>Więcej poradników <span>→</span></a>
      </div>
      <div class="home-featured-guide-grid">
        {featuredGuides.map((guide) => (
          <a class="home-featured-guide" href={link(guide.href)}>
            <h3>{guide.title}</h3>
            <p>{guide.description}</p>
            <b>Zobacz rozwiązanie →</b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-functions-section">
    <div class="wrap">
      <div class="home-section-head">
        <div>
          <span class="section-kicker">Szybka referencja</span>
          <h2>Najczęściej używane funkcje</h2>
        </div>
        <a class="section-link" href={link("/funkcje/")}>Pełna baza funkcji <span>→</span></a>
      </div>

      <div class="home-function-grid">
        {popularFunctions.map((fn) => (
          <a class="home-function-card" href={link('/funkcje/' + fn.slug + '/')}>
            <div>
              <code>{fn.name}</code>
              <span>{fn.category}</span>
            </div>
            <p>{fn.description}</p>
            <b>Składnia i przykłady →</b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-tools-section">
    <div class="wrap">
      <div class="home-section-head">
        <div>
          <span class="section-kicker">Nie wpisuj formuły ręcznie</span>
          <h2>Narzędzia, które robią część pracy</h2>
        </div>
        <a class="section-link" href={link("/narzedzia/")}>Wszystkie narzędzia <span>→</span></a>
      </div>

      <div class="home-tools-grid">
        {toolHighlights.map((tool) => (
          <a class="home-tool-card" href={link(tool.href)}>
            <span>{tool.icon}</span>
            <div>
              <h3>{tool.title}</h3>
              <p>{tool.text}</p>
            </div>
            <b>→</b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section home-templates-section">
    <div class="wrap">
      <div class="home-section-head">
        <div>
          <span class="section-kicker">Darmowe pliki XLSX</span>
          <h2>Nie buduj arkusza od zera</h2>
        </div>
        <a class="section-link" href={link("/szablony/")}>Wszystkie szablony <span>→</span></a>
      </div>

      <div class="template-grid template-grid-live">
        {templateCatalog.map((template) => (
          <a class="template-card template-card-live" href={link('/szablony/' + template.slug + '/')}>
            <div class="template-thumb">
              <span>{template.icon}</span>
              <div></div><div></div><div></div>
              <div class="template-mini-kpis">
                <i></i><i></i><i></i>
              </div>
            </div>
            <div class="template-meta">
              <span>{template.type}</span>
              <b>{template.version}</b>
            </div>
            <h3>{template.title}</h3>
            <p>{template.description}</p>
            <div class="template-card-footer">
              <span>XLSX · Darmowy</span>
              <strong>Zobacz i pobierz →</strong>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-final-cta">
    <div class="wrap">
      <div class="home-final-box">
        <div>
          <span class="section-kicker light">Nie wiesz, gdzie zacząć?</span>
          <h2>Po prostu wpisz problem.</h2>
          <p>Wyszukiwarka przejrzy poradniki, funkcje, narzędzia i pozostałe strony serwisu.</p>
        </div>
        <button type="button" data-global-search-open>
          <span>⌕</span>
          <strong>Otwórz wyszukiwarkę</strong>
          <kbd>Ctrl K</kbd>
        </button>
      </div>
    </div>
  </section>
</BaseLayout>
