---
import BaseLayout from '../layouts/BaseLayout.astro';
import Search from '../components/Search.astro';
import { withBase as link } from '../utils/paths.js';
---

<BaseLayout
  title="Nie znaleziono strony | ExcelNaLuzie"
  description="Ta strona nie istnieje. Wyszukaj poradnik, funkcję, makro VBA albo narzędzie na ExcelNaLuzie.pl."
  canonical="/404/"
  noindex={true}
>
  <section class="error-page">
    <div class="wrap error-page-grid">
      <div class="error-copy">
        <span class="error-code">404</span>
        <span class="section-kicker">Tego arkusza tu nie ma</span>
        <h1>Nie znaleźliśmy tej strony.</h1>
        <p>Adres mógł się zmienić albo zawiera literówkę. Najszybciej będzie wyszukać rozwiązanie poniżej.</p>
        <Search/>
        <div class="error-actions">
          <a class="hub-primary" href={link("/")}>Strona główna <span>→</span></a>
          <a class="hub-secondary" href={link("/formuly/")}>Wszystkie poradniki</a>
        </div>
      </div>

      <div class="error-sheet" aria-hidden="true">
        <div class="error-sheet-cell error-sheet-head">A1</div>
        <div class="error-sheet-cell error-sheet-formula">#ADR!</div>
        <div class="error-sheet-message">
          <strong>Nieprawidłowe odwołanie</strong>
          <span>Sprawdź adres strony albo użyj wyszukiwarki.</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
