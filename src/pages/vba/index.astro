---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase as link } from '../../utils/paths.js';
import { vbaCatalog } from '../../data/vbaCatalog.js';
---

<BaseLayout
  navSection="vba"
  title="VBA Excel — gotowe makra i automatyzacje | ExcelNaLuzie"
  description="Praktyczne przykłady VBA do Excela: zakresy, arkusze, pliki, PDF, Outlook i przyspieszanie makr. Gotowy kod do skopiowania."
>
  <section class="hub-hero hub-vba">
    <div class="wrap hub-hero-grid">
      <div>
        <nav class="hub-breadcrumbs"><a href={link("/")}>ExcelNaLuzie</a><span>›</span><strong>VBA</strong></nav>
        <span class="hub-kicker">VBA w Excelu</span>
        <h1>Makra, które robią<br/><em>konkretną robotę.</em></h1>
        <p>Gotowe fragmenty kodu, praktyczne automatyzacje i krótkie wyjaśnienia. Kopiujesz kod, zmieniasz wskazane miejsca i działasz.</p>
        <div class="hub-actions">
          <a class="hub-primary" href="#poradniki">10 poradników <span>↓</span></a>
          <a class="hub-secondary" href={link("/#szukaj")}>Szukaj rozwiązania</a>
        </div>
      </div>

      <div class="code-window" aria-hidden="true">
        <div class="code-window-top"><i></i><i></i><i></i><span>Module1.bas</span></div>
        <pre><code><span class="code-key">Sub</span> OstatniWiersz()
  <span class="code-key">Dim</span> lastRow <span class="code-key">As Long</span>

  lastRow = Cells(Rows.Count, <span class="code-str">"A"</span>) _
    .End(xlUp).Row

  MsgBox <span class="code-str">"Ostatni wiersz: "</span> & lastRow
<span class="code-key">End Sub</span></code></pre>
        <div class="code-status"><span>●</span> Gotowe do wklejenia</div>
      </div>
    </div>
  </section>

  <section class="hub-section" id="poradniki">
    <div class="wrap">
      <div class="hub-section-head">
        <div><span class="section-kicker">Pierwsza biblioteka</span><h2>10 gotowych poradników VBA</h2></div>
        <p>Od podstaw pracy z zakresem, przez pliki i PDF, aż po Outlook i wydajność większych makr.</p>
      </div>

      <div class="vba-directory-grid">
        {vbaCatalog.map((article, index) => (
          <a class="vba-directory-card" href={link('/vba/' + article.slug + '/')}>
            <div class="vba-directory-top">
              <span>{String(index + 1).padStart(2,'0')}</span>
              <small>{article.category}</small>
            </div>
            <h3>{article.shortTitle}</h3>
            <p>{article.description}</p>
            <div class="vba-directory-footer">
              <span>{article.readingTime}</span>
              <b>Otwórz kod →</b>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="hub-section hub-section-alt">
    <div class="wrap">
      <div class="hub-section-head">
        <div><span class="section-kicker">Standard poradników</span><h2>Kod ma być użyteczny od razu</h2></div>
        <p>Każdy poradnik ma ten sam schemat, więc od razu wiesz, gdzie znaleźć kod, miejsca do zmiany i typowe pułapki.</p>
      </div>

      <div class="reference-steps">
        <div><span>01</span><strong>Gotowy kod</strong><p>Kompletny fragment VBA do skopiowania jednym przyciskiem.</p></div>
        <div><span>02</span><strong>Co zmienić</strong><p>Nazwy arkuszy, zakresy i parametry są wskazane osobno.</p></div>
        <div><span>03</span><strong>Dlaczego działa</strong><p>Krótkie wyjaśnienie i lista najczęstszych błędów.</p></div>
      </div>
    </div>
  </section>

  <section class="hub-cta-section">
    <div class="wrap hub-cta">
      <div><span class="section-kicker light">Następny poziom</span><h2>Biblioteka VBA będzie rosnąć.</h2><p>Kolejne makra dodamy według realnych problemów i danych z wyszukiwarki.</p></div>
      <a href={link("/#szukaj")}>Szukaj na stronie <span>→</span></a>
    </div>
  </section>
</BaseLayout>
