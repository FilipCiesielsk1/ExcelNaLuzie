---
import BaseLayout from './BaseLayout.astro';
import { withBase as link } from '../utils/paths.js';
import { articleClusters } from '../data/articleClusters.js';

const { frontmatter } = Astro.props;

const {
  title,
  description,
  slug,
  category='Excel',
  categorySlug='formuly',
  date,
  updated=date,
  author='Filip Ciesielski',
  excelVersions=[],
  difficulty='Podstawowy',
  readingTime='3 min',
  verified=false,
  related=[]
} = frontmatter;

const canonical = `/poradniki/${slug}/`;
const absoluteUrl = `https://excelnaluzie.pl${canonical}`;

const cluster = articleClusters[categorySlug] || null;
const clusterIndex = cluster ? cluster.articles.findIndex((item) => item.slug === slug) : -1;
const previousArticle = clusterIndex > 0 ? cluster.articles[clusterIndex - 1] : null;
const nextArticle = cluster && clusterIndex >= 0 && clusterIndex < cluster.articles.length - 1
  ? cluster.articles[clusterIndex + 1]
  : null;

const automaticRelated = cluster && clusterIndex >= 0
  ? [
      ...cluster.articles.slice(clusterIndex + 1),
      ...cluster.articles.slice(0, clusterIndex).reverse()
    ]
      .slice(0, 3)
      .map((item) => ({
        title: item.title,
        url: `/poradniki/${item.slug}/`,
        category: cluster.title
      }))
  : [];

const relatedCandidates = [
  ...related,
  ...automaticRelated,
  ...(cluster ? [{ title: cluster.title, url: cluster.hub, category: 'Cały temat' }] : [])
];

const seenRelatedUrls = new Set();
const effectiveRelated = relatedCandidates
  .filter((item) => {
    if (!item?.url || item.url === canonical || seenRelatedUrls.has(item.url)) return false;
    seenRelatedUrls.add(item.url);
    return true;
  })
  .slice(0, 4);

const schema = {
  '@context':'https://schema.org',
  '@graph':[
    {
      '@type':'Article',
      '@id':`${absoluteUrl}#article`,
      headline:title,
      description,
      datePublished:date,
      dateModified:updated,
      inLanguage:'pl-PL',
      mainEntityOfPage:{'@type':'WebPage','@id':absoluteUrl},
      author:{'@type':'Person',name:author,url:'https://excelnaluzie.pl/o-serwisie/'},
      publisher:{'@id':'https://excelnaluzie.pl/#organization'},
      isPartOf:{'@id':'https://excelnaluzie.pl/#website'}
    },
    {
      '@type':'BreadcrumbList',
      itemListElement:[
        {'@type':'ListItem',position:1,name:'ExcelNaLuzie',item:'https://excelnaluzie.pl/'},
        {'@type':'ListItem',position:2,name:category,item:`https://excelnaluzie.pl/${categorySlug}/`},
        {'@type':'ListItem',position:3,name:title,item:absoluteUrl}
      ]
    }
  ]
};
---

<BaseLayout
  title={`${title} | ExcelNaLuzie`}
  description={description}
  canonical={canonical}
  ogType="article"
  navSection={categorySlug.split('/')[0]}
  articlePublishedTime={date}
  articleModifiedTime={updated}
  articleAuthor={author}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

  <div class="article-page">
    <div class="article-layout">
      <article class="article-main" data-pagefind-body data-article-body>
        <nav class="breadcrumbs" aria-label="Okruszki">
          <a href={link("/")}>ExcelNaLuzie</a>
          <span>›</span>
          <a href={link(`/${categorySlug}/`)}>{category}</a>
          <span>›</span>
          <span>Poradnik</span>
        </nav>

        <header class="article-header">
          <span class="article-category">{category}</span>
          <h1 data-pagefind-meta="title">{title}</h1>
          <p class="article-lead">{description}</p>

          <div class="article-meta">
            <span><strong><a href={link("/o-serwisie/")}>{author}</a></strong></span>
            <span>{readingTime} czytania</span>
            <span>Poziom: {difficulty}</span>
            {excelVersions.length > 0 && <span>{excelVersions.join(' · ')}</span>}
            {verified && <span class="verified-badge">✓ Przykład sprawdzony</span>}
          </div>

          <div class="article-updated">
            Opublikowano: {date} · Aktualizacja: {updated}
          </div>
        </header>

        <div class="article-content">
          <slot/>
        </div>

        {cluster && clusterIndex >= 0 && (
          <nav class="cluster-nav" aria-label={`Nawigacja w klastrze ${cluster.title}`}>
            <div class="cluster-nav-side">
              {previousArticle ? (
                <a href={link(`/poradniki/${previousArticle.slug}/`)}>
                  <small>← Poprzedni poradnik</small>
                  <strong>{previousArticle.title}</strong>
                </a>
              ) : <span aria-hidden="true"></span>}
            </div>

            <a class="cluster-nav-hub" href={link(cluster.hub)}>
              <small>Cały klaster</small>
              <strong>{cluster.title}</strong>
              <span>{clusterIndex + 1} / {cluster.articles.length}</span>
            </a>

            <div class="cluster-nav-side cluster-nav-next">
              {nextArticle ? (
                <a href={link(`/poradniki/${nextArticle.slug}/`)}>
                  <small>Następny poradnik →</small>
                  <strong>{nextArticle.title}</strong>
                </a>
              ) : <span aria-hidden="true"></span>}
            </div>
          </nav>
        )}

        <section class="article-author" aria-label="O autorze">
          <div class="author-avatar" aria-hidden="true">FC</div>
          <div>
            <span class="author-label">Autor</span>
            <strong><a href={link("/o-serwisie/")}>{author}</a></strong>
            <p>Twórca ExcelNaLuzie. Poradniki są przygotowywane tak, aby najpierw dawać działające rozwiązanie, a dopiero potem wyjaśniać szczegóły.</p>
          </div>
        </section>

        <section class="related related-seo">
          <div class="related-head">
            <span class="section-kicker">Czytaj dalej</span>
            <h2>Powiązane materiały</h2>
          </div>

          {effectiveRelated.length > 0 ? (
            <div class="related-grid">
              {effectiveRelated.map((item) => (
                <a href={link(item.url)}>
                  <small>{item.category || 'Poradnik'}</small>
                  <strong>{item.title}</strong>
                  <span>→</span>
                </a>
              ))}
            </div>
          ) : (
            <div class="related-grid">
              <a href={link("/formuly/")}><small>Baza wiedzy</small><strong>Formuły Excel</strong><span>→</span></a>
              <a href={link("/funkcje/")}><small>Referencje</small><strong>Baza funkcji</strong><span>→</span></a>
              <a href={link("/narzedzia/")}><small>Online</small><strong>Narzędzia Excel</strong><span>→</span></a>
            </div>
          )}
        </section>
      </article>

      <aside class="article-sidebar" aria-label="Spis treści">
        <div class="toc-card">
          <span class="toc-label">W tym poradniku</span>
          <nav id="article-toc"></nav>
        </div>
        <a class="sidebar-search" href={link("/#szukaj")}>
          <span>Nie znalazłeś odpowiedzi?</span>
          <strong>Przeszukaj ExcelNaLuzie →</strong>
        </a>
      </aside>
    </div>
  </div>

  <script is:inline>
    const article = document.querySelector('[data-article-body]');
    const toc = document.querySelector('#article-toc');

    if (article && toc) {
      const headings = [...article.querySelectorAll('.article-content h2, .article-content h3')];

      if (!headings.length) {
        toc.closest('.toc-card')?.remove();
      } else {
        const slugify = (text) => text
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');

        headings.forEach((heading, index) => {
          if (!heading.id) heading.id = slugify(heading.textContent) || 'sekcja-' + (index + 1);

          const a = document.createElement('a');
          a.href = '#' + heading.id;
          a.textContent = heading.textContent;
          if (heading.tagName === 'H3') a.classList.add('toc-sub');
          toc.appendChild(a);
        });
      }

      article.querySelectorAll('.formula').forEach((box) => {
        const formula = box.textContent.trim();
        if (!formula || box.querySelector('.formula-copy')) return;

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'formula-copy';
        button.textContent = 'Kopiuj';
        button.setAttribute('aria-label', 'Kopiuj formułę');

        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(formula);
            button.textContent = 'Skopiowano ✓';
            setTimeout(() => button.textContent = 'Kopiuj', 1500);
          } catch {
            button.textContent = 'Zaznacz ręcznie';
          }
        });

        box.appendChild(button);
      });
    }
  </script>
</BaseLayout>