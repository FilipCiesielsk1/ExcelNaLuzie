---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/paths.js';
import '../styles/global.css';

const {
  title='ExcelNaLuzie — rozwiązania do Excela bez zbędnego gadania',
  description='Praktyczne formuły, VBA, poradniki, narzędzia i gotowe rozwiązania problemów z Excelem.',
  canonical=Astro.url.pathname,
  ogType='website',
  image=null,
  noindex=false,
  navSection=null,
  articlePublishedTime=null,
  articleModifiedTime=null,
  articleAuthor=null
} = Astro.props;

const siteOrigin = 'https://excelnaluzie.pl';
const canonicalPath = canonical.replace(/^\/ExcelNaLuzie\/?/, '/');
const url=new URL(canonicalPath, siteOrigin);
const favicon = withBase('/favicon.svg');
const ogImage = image ? new URL(image, siteOrigin) : null;

const currentPath = canonicalPath.replace(/^\/+|\/+$/g, '');
const inferredNavSection = navSection || currentPath.split('/')[0] || null;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#107c41"/>
    <meta name="color-scheme" content="light"/>
    <!-- AdSense: weryfikacja własności witryny -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7527132820449605" crossorigin="anonymous"></script>
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}/>
    <title>{title}</title>
    <meta name="description" content={description}/>
    <link rel="canonical" href={url}/>
    <link rel="icon" type="image/svg+xml" href={favicon}/>

    <meta property="og:locale" content="pl_PL"/>
    <meta property="og:site_name" content="ExcelNaLuzie.pl"/>
    <meta property="og:type" content={ogType}/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={url}/>
    {ogImage && <meta property="og:image" content={ogImage}/>}
    {ogType === 'article' && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime}/>}
    {ogType === 'article' && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime}/>}
    {ogType === 'article' && articleAuthor && <meta property="article:author" content={articleAuthor}/>}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'}/>
    <meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/>
    {ogImage && <meta name="twitter:image" content={ogImage}/>}

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context':'https://schema.org',
      '@graph':[
        {
          '@type':'Organization',
          '@id':siteOrigin + '/#organization',
          name:'ExcelNaLuzie.pl',
          url:siteOrigin + '/',
          logo:{
            '@type':'ImageObject',
            url:siteOrigin + '/favicon.svg'
          }
        },
        {
          '@type':'WebSite',
          '@id':siteOrigin + '/#website',
          name:'ExcelNaLuzie.pl',
          url:siteOrigin + '/',
          inLanguage:'pl-PL',
          publisher:{'@id':siteOrigin + '/#organization'}
        }
      ]
    })}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Przejdź do treści</a>
    <Header activeSection={inferredNavSection}/>
    <main id="main-content" tabindex="-1"><slot/></main>
    <Footer/>
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token":"e95a42d41be14398885d7892394fcc3f"}'
    ></script>
  </body>
</html>