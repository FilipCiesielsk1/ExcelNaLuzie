---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/paths.js';
import '../styles/global.css';

const {
  title='ExcelNaLuzie — rozwiązania do Excela bez zbędnego gadania',
  description='Praktyczne formuły, VBA, poradniki, narzędzia i gotowe rozwiązania problemów z Excelem.',
  canonical=Astro.url.pathname,
  ogType='website',
  image=null,
  noindex=false,
  navSection=null
} = Astro.props;

const canonicalPath = canonical.replace(/^\/ExcelNaLuzie\/?/, '/');
const url=new URL(canonicalPath, 'https://excelnaluzie.pl');
const favicon = withBase('/favicon.svg');
const ogImage = image ? new URL(image, 'https://excelnaluzie.pl') : null;

const currentPath = canonicalPath.replace(/^\/+|\/+$/g, '');
const inferredNavSection = navSection || currentPath.split('/')[0] || null;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="theme-color" content="#107c41"/>
    <meta name="color-scheme" content="light"/>
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}/>
    <title>{title}</title>
    <meta name="description" content={description}/>
    <link rel="canonical" href={url}/>
    <link rel="icon" type="image/svg+xml" href={favicon}/>

    <meta property="og:locale" content="pl_PL"/>
    <meta property="og:site_name" content="ExcelNaLuzie.pl"/>
    <meta property="og:type" content={ogType}/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={url}/>
    {ogImage && <meta property="og:image" content={ogImage}/>}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'}/>
    <meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/>
    {ogImage && <meta name="twitter:image" content={ogImage}/>}

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context':'https://schema.org',
      '@type':'WebSite',
      name:'ExcelNaLuzie.pl',
      url:'https://excelnaluzie.pl'
    })}></script>
  </head>
  <body>
    <Header activeSection={inferredNavSection}/>
    <main><slot/></main>
    <Footer/>
  </body>
</html>