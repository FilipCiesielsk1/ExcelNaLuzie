---
import BaseLayout from './BaseLayout.astro';
import { withBase as link } from '../utils/paths.js';

const {
  title,
  description,
  slug,
  functionName,
  functionHref,
  resourceLabel = 'Powiązana funkcja',
  resourceAction = 'Zobacz składnię i przykłady →'
} = Astro.props;

const canonical = `/narzedzia/${slug}/`;
const absoluteUrl = `https://excelnaluzie.pl${canonical}`;

const schema = {
  '@context':'https://schema.org',
  '@graph':[
    {
      '@type':'WebApplication',
      '@id':absoluteUrl + '#app',
      name:title,
      description,
      url:absoluteUrl,
      applicationCategory:'BusinessApplication',
      operatingSystem:'Any',
      browserRequirements:'JavaScript',
      inLanguage:'pl-PL',
      isAccessibleForFree:true,
      author:{'@type':'Person',name:'Filip Ciesielski',url:'https://excelnaluzie.pl/o-serwisie/'},
      publisher:{'@type':'Organization',name:'ExcelNaLuzie.pl',url:'https://excelnaluzie.pl/'}
    },
    {
      '@type':'BreadcrumbList',
      itemListElement:[
        {'@type':'ListItem',position:1,name:'ExcelNaLuzie',item:'https://excelnaluzie.pl/'},
        {'@type':'ListItem',position:2,name:'Narzędzia Excel',item:'https://excelnaluzie.pl/narzedzia/'},
        {'@type':'ListItem',position:3,name:title,item:absoluteUrl}
      ]
    }
  ]
};
---

<BaseLayout
  navSection="narzedzia"
  title={`${title} | ExcelNaLuzie`}
  description={description}
  canonical={canonical}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

  <div class="tool-page">
    <div class="tool-page-wrap">
      <nav class="breadcrumbs" aria-label="Okruszki">
        <a href={link("/")}>ExcelNaLuzie</a>
        <span>›</span>
        <a href={link("/narzedzia/")}>Narzędzia</a>
        <span>›</span>
        <strong>{title}</strong>
      </nav>

      <header class="tool-page-header">
        <span class="article-category">Narzędzie online</span>
        <h1>{title}</h1>
        <p>{description}</p>
      </header>

      <div class="tool-page-layout">
        <main class="tool-generator-panel">
          <slot/>
        </main>

        <aside class="tool-page-sidebar">
          <div class="tool-side-card">
            <span>Prywatność</span>
            <strong>Wszystko działa lokalnie</strong>
            <p>Dane wpisane do generatora nie są wysyłane na serwer.</p>
          </div>

          <div class="tool-side-card">
            <span>{resourceLabel}</span>
            <strong>{functionName}</strong>
            <a href={link(functionHref)}>{resourceAction}</a>
          </div>

          <a class="sidebar-search" href={link("/narzedzia/")}>
            <span>Więcej narzędzi</span>
            <strong>Wszystkie generatory →</strong>
          </a>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>
