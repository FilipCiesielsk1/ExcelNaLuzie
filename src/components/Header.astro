---
import { withBase as link } from '../utils/paths.js';

const { activeSection = null } = Astro.props;

const items = [
  { key: 'formuly', label: 'Formuły', href: '/formuly/' },
  { key: 'funkcje', label: 'Funkcje', href: '/funkcje/' },
  { key: 'vba', label: 'VBA', href: '/vba/' },
  { key: 'narzedzia', label: 'Narzędzia', href: '/narzedzia/' },
  { key: 'szablony', label: 'Szablony', href: '/szablony/' },
  { key: 'uslugi', label: 'Współpraca', href: '/uslugi/excel-vba/' }
];
---

<header class="site-header">
  <div class="wrap nav">
    <a class="brand" href={link("/")} aria-label="ExcelNaLuzie.pl — strona główna">
      <span class="brand-mark" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
      </span>
      <span class="brand-name">Excel<span>NaLuzie</span></span>
    </a>

    <nav class="menu" aria-label="Główna nawigacja">
      {items.map((item) => (
        <a
          href={link(item.href)}
          class:list={{ active: activeSection === item.key }}
          aria-current={activeSection === item.key ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <button
      class="header-search"
      type="button"
      data-global-search-open
      aria-label="Otwórz wyszukiwarkę"
      aria-haspopup="dialog"
    >
      <span aria-hidden="true">⌕</span>
      <span>Szukaj</span>
      <kbd>Ctrl K</kbd>
    </button>

    <details class="mobile-menu">
      <summary aria-label="Otwórz menu nawigacji">
        <span aria-hidden="true" class="mobile-menu-icon">☰</span>
        <span>Menu</span>
      </summary>
      <nav class="mobile-menu-panel" aria-label="Nawigacja mobilna">
        <button class="mobile-search-button" type="button" data-global-search-open>
          <span>⌕ Szukaj na stronie</span>
          <b aria-hidden="true">→</b>
        </button>
        {items.map((item) => (
          <a
            href={link(item.href)}
            class:list={{ active: activeSection === item.key }}
            aria-current={activeSection === item.key ? 'page' : undefined}
          >
            <span>{item.label}</span>
            <b aria-hidden="true">→</b>
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<div class="global-search-layer" data-global-search hidden>
  <button class="global-search-backdrop" type="button" data-global-search-close aria-label="Zamknij wyszukiwarkę"></button>

  <section
    class="global-search-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="global-search-title"
  >
    <div class="global-search-head">
      <div>
        <span class="global-search-kicker">Wyszukiwarka ExcelNaLuzie</span>
        <h2 id="global-search-title">Czego szukasz?</h2>
      </div>
      <button class="global-search-close" type="button" data-global-search-close aria-label="Zamknij">
        ×
      </button>
    </div>

    <div class="global-search-input-wrap">
      <span aria-hidden="true">⌕</span>
      <input
        type="search"
        data-global-search-input
        placeholder="Np. X.WYSZUKAJ, daty, FILTRUJ, tekst po znaku..."
        autocomplete="off"
        spellcheck="false"
        aria-label="Szukaj w ExcelNaLuzie"
      />
      <kbd>Esc</kbd>
    </div>

    <div class="global-search-hints" data-search-hints>
      <button type="button" data-search-example="X.WYSZUKAJ">X.WYSZUKAJ</button>
      <button type="button" data-search-example="JEŻELI">JEŻELI</button>
      <button type="button" data-search-example="daty">daty</button>
      <button type="button" data-search-example="FILTRUJ">FILTRUJ</button>
      <button type="button" data-search-example="tekst">tekst</button>
    </div>

    <div class="global-search-status" data-search-status aria-live="polite">
      Wpisz co najmniej 2 znaki. Przeszukujemy poradniki, funkcje i narzędzia.
    </div>

    <div class="global-search-results" data-search-results></div>

    <div class="global-search-footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> wybór</span>
      <span><kbd>Enter</kbd> otwórz</span>
      <span><kbd>Esc</kbd> zamknij</span>
    </div>
  </section>
</div>

<script>
  const searchLayer = document.querySelector('[data-global-search]');
  const searchInput = searchLayer?.querySelector('[data-global-search-input]');
  const searchResults = searchLayer?.querySelector('[data-search-results]');
  const searchStatus = searchLayer?.querySelector('[data-search-status]');
  const searchHints = searchLayer?.querySelector('[data-search-hints]');
  const closeButtons = searchLayer?.querySelectorAll('[data-global-search-close]') || [];
  const exampleButtons = searchLayer?.querySelectorAll('[data-search-example]') || [];

  let lastFocusedElement = null;
  let pagefind = null;
  let loadPromise = null;
  let searchTimer = null;
  let requestNumber = 0;
  let activeIndex = -1;
  let resultLinks = [];

  const categoryForUrl = (url) => {
    if (url.includes('/poradniki/')) return 'Poradnik';
    if (url.includes('/funkcje/')) return 'Funkcja';
    if (url.includes('/narzedzia/')) return 'Narzędzie';
    if (url.includes('/formuly/')) return 'Formuły';
    if (url.includes('/vba/')) return 'VBA';
    if (url.includes('/szablony/')) return 'Szablon';
    return 'Strona';
  };

  const loadPagefind = async () => {
    if (pagefind) return pagefind;
    if (!loadPromise) {
      loadPromise = import(/* @vite-ignore */ '/pagefind/pagefind.js')
        .then(async (module) => {
          pagefind = module;
          if (typeof pagefind.init === 'function') await pagefind.init();
          return pagefind;
        })
        .catch((error) => {
          console.error('Pagefind load failed', error);
          loadPromise = null;
          throw error;
        });
    }
    return loadPromise;
  };

  const setOpen = (open) => {
    if (!searchLayer || !searchInput) return;

    if (open) {
      if (searchLayer.hidden) lastFocusedElement = document.activeElement;
      searchLayer.hidden = false;
      document.documentElement.classList.add('search-open');
      requestAnimationFrame(() => {
        searchLayer.classList.add('open');
        searchInput.focus();
        searchInput.select();
      });
      loadPagefind().catch(() => {
        searchStatus.textContent = 'Nie udało się uruchomić wyszukiwarki. Odśwież stronę i spróbuj ponownie.';
        searchStatus.classList.add('error');
      });
    } else {
      searchLayer.classList.remove('open');
      document.documentElement.classList.remove('search-open');
      setTimeout(() => {
        if (!searchLayer.classList.contains('open')) searchLayer.hidden = true;
      }, 160);
      activeIndex = -1;
      const restoreFocus = lastFocusedElement;
      lastFocusedElement = null;
      restoreFocus?.focus?.({ preventScroll: true });
    }
  };

  const escapeHtml = (value) => String(value ?? '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#039;');

  const updateActiveResult = () => {
    resultLinks.forEach((link, index) => {
      const active = index === activeIndex;
      link.classList.toggle('active', active);
      link.setAttribute('aria-selected', active ? 'true' : 'false');
      if (active) link.scrollIntoView({ block: 'nearest' });
    });
  };

  const renderResults = (items, query) => {
    if (!searchResults || !searchStatus || !searchHints) return;

    searchResults.replaceChildren();
    resultLinks = [];
    activeIndex = -1;

    if (!items.length) {
      searchStatus.textContent = 'Brak wyników dla „' + query + '”. Spróbuj krótszej frazy albo innej nazwy funkcji.';
      searchHints.hidden = false;
      return;
    }

    searchStatus.textContent = 'Znaleziono ' + items.length + (items.length === 1 ? ' wynik.' : ' wyników.');
    searchHints.hidden = true;

    for (const item of items) {
      const link = document.createElement('a');
      link.className = 'global-search-result';
      link.href = item.url;
      link.setAttribute('role', 'option');

      const top = document.createElement('div');
      top.className = 'global-search-result-top';

      const category = document.createElement('span');
      category.className = 'global-search-result-category';
      category.textContent = categoryForUrl(item.url);

      const arrow = document.createElement('b');
      arrow.textContent = '→';

      top.append(category, arrow);

      const title = document.createElement('strong');
      title.textContent = item.meta?.title || item.title || 'Bez tytułu';

      const description = document.createElement('p');
      description.textContent = item.meta?.description || item.excerpt?.replace(/<[^>]+>/g, '') || '';

      link.append(top, title, description);
      searchResults.appendChild(link);
      resultLinks.push(link);
    }
  };

  const runSearch = async () => {
    if (!searchInput || !searchStatus || !searchResults || !searchHints) return;

    const query = searchInput.value.trim();
    const localRequest = ++requestNumber;

    if (query.length < 2) {
      searchResults.replaceChildren();
      resultLinks = [];
      activeIndex = -1;
      searchStatus.textContent = 'Wpisz co najmniej 2 znaki. Przeszukujemy poradniki, funkcje i narzędzia.';
      searchStatus.classList.remove('error');
      searchHints.hidden = false;
      return;
    }

    searchStatus.textContent = 'Szukam…';
    searchStatus.classList.remove('error');

    try {
      const pf = await loadPagefind();
      const search = await pf.search(query);

      const data = await Promise.all(
        search.results.slice(0, 9).map((result) => result.data())
      );

      if (localRequest !== requestNumber) return;
      renderResults(data, query);
    } catch (error) {
      if (localRequest !== requestNumber) return;
      console.error(error);
      searchResults.replaceChildren();
      searchStatus.textContent = 'Nie udało się wyszukać. Spróbuj ponownie po odświeżeniu strony.';
      searchStatus.classList.add('error');
    }
  };

  document.addEventListener('click', (event) => {
    const opener = event.target.closest?.('[data-global-search-open]');
    if (opener) {
      event.preventDefault();
      setOpen(true);
    }
  });

  closeButtons.forEach((button) => button.addEventListener('click', () => setOpen(false)));

  exampleButtons.forEach((button) => {
    button.addEventListener('click', () => {
      searchInput.value = button.dataset.searchExample || '';
      searchInput.focus();
      runSearch();
    });
  });

  searchLayer?.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab' || searchLayer.hidden) return;
    const candidates = [...searchLayer.querySelectorAll(
      'button:not([disabled]), input:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])'
    )].filter((element) => element.getClientRects().length > 0);
    if (!candidates.length) return;
    const first = candidates[0];
    const last = candidates[candidates.length - 1];
    if (event.shiftKey && (document.activeElement === first || !searchLayer.contains(document.activeElement))) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  searchInput?.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(runSearch, 120);
  });

  searchInput?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown' && resultLinks.length) {
      event.preventDefault();
      activeIndex = (activeIndex + 1) % resultLinks.length;
      updateActiveResult();
    }

    if (event.key === 'ArrowUp' && resultLinks.length) {
      event.preventDefault();
      activeIndex = activeIndex <= 0 ? resultLinks.length - 1 : activeIndex - 1;
      updateActiveResult();
    }

    if (event.key === 'Enter' && activeIndex >= 0 && resultLinks[activeIndex]) {
      event.preventDefault();
      resultLinks[activeIndex].click();
    }

    if (event.key === 'Escape') {
      setOpen(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target;
    const typing = target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target?.isContentEditable;

    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      setOpen(true);
      return;
    }

    if (event.key === 'Escape' && searchLayer && !searchLayer.hidden) {
      setOpen(false);
      return;
    }

    if (!typing && event.key === '/' && searchLayer?.hidden) {
      event.preventDefault();
      setOpen(true);
    }
  });
</script>

<style is:global>
  html.search-open {
    overflow: hidden;
  }

  .header-search {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid rgba(20, 29, 39, .11);
    background: rgba(255,255,255,.72);
    color: inherit;
    border-radius: 999px;
    padding: 8px 11px;
    cursor: pointer;
    font: inherit;
  }

  .header-search:hover {
    background: #fff;
    border-color: rgba(16,124,65,.26);
  }

  .header-search kbd {
    font-size: 10px;
    opacity: .5;
    border: 1px solid rgba(20,29,39,.12);
    border-radius: 5px;
    padding: 2px 5px;
    background: rgba(20,29,39,.035);
  }

  .mobile-search-button {
    width: 100%;
    border: 0;
    background: transparent;
    color: inherit;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font: inherit;
    padding: 12px 0;
    cursor: pointer;
    text-align: left;
  }

  .global-search-layer[hidden] {
    display: none !important;
  }

  .global-search-layer {
    position: fixed;
    inset: 0;
    z-index: 5000;
    display: grid;
    place-items: start center;
    padding: min(10vh, 90px) 20px 24px;
    opacity: 0;
    transition: opacity .16s ease;
  }

  .global-search-layer.open {
    opacity: 1;
  }

  .global-search-backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(10, 18, 14, .58);
    backdrop-filter: blur(7px);
    cursor: default;
  }

  .global-search-dialog {
    position: relative;
    z-index: 1;
    width: min(760px, 100%);
    max-height: min(760px, calc(100vh - 110px));
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: rgba(255,255,255,.985);
    border: 1px solid rgba(255,255,255,.7);
    border-radius: 22px;
    box-shadow: 0 28px 90px rgba(0,0,0,.28);
    transform: translateY(-8px) scale(.99);
    transition: transform .16s ease;
  }

  .global-search-layer.open .global-search-dialog {
    transform: translateY(0) scale(1);
  }

  .global-search-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
    padding: 22px 24px 10px;
  }

  .global-search-head h2 {
    margin: 2px 0 0;
    font-size: clamp(23px, 3vw, 31px);
    line-height: 1.1;
  }

  .global-search-kicker {
    display: block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #107c41;
  }

  .global-search-close {
    flex: 0 0 auto;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(20,29,39,.1);
    border-radius: 50%;
    background: rgba(20,29,39,.035);
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
  }

  .global-search-input-wrap {
    margin: 8px 24px 0;
    display: flex;
    align-items: center;
    gap: 10px;
    border: 2px solid rgba(16,124,65,.2);
    background: #fff;
    border-radius: 15px;
    padding: 0 13px;
    box-shadow: 0 5px 18px rgba(20,29,39,.055);
  }

  .global-search-input-wrap:focus-within {
    border-color: rgba(16,124,65,.65);
    box-shadow: 0 0 0 4px rgba(16,124,65,.08);
  }

  .global-search-input-wrap > span {
    font-size: 22px;
    color: #107c41;
  }

  .global-search-input-wrap input {
    min-width: 0;
    flex: 1;
    height: 54px;
    border: 0;
    outline: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 16px;
  }

  .global-search-input-wrap kbd,
  .global-search-footer kbd {
    border: 1px solid rgba(20,29,39,.12);
    background: rgba(20,29,39,.04);
    border-radius: 6px;
    padding: 2px 6px;
    font-size: 10px;
  }

  .global-search-hints {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
    padding: 13px 24px 0;
  }

  .global-search-hints[hidden] {
    display: none;
  }

  .global-search-hints button {
    border: 1px solid rgba(20,29,39,.1);
    border-radius: 999px;
    background: #fff;
    padding: 6px 9px;
    color: inherit;
    cursor: pointer;
    font-size: 12px;
  }

  .global-search-hints button:hover {
    border-color: rgba(16,124,65,.3);
    background: rgba(16,124,65,.05);
  }

  .global-search-status {
    padding: 13px 24px 9px;
    color: rgba(20,29,39,.58);
    font-size: 12px;
  }

  .global-search-status.error {
    color: #a32929;
  }

  .global-search-results {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 14px 10px;
    scrollbar-width: thin;
  }

  .global-search-result {
    display: block;
    color: inherit;
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: 14px;
    padding: 12px 12px 13px;
  }

  .global-search-result + .global-search-result {
    border-top-color: rgba(20,29,39,.06);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }

  .global-search-result:hover,
  .global-search-result.active {
    background: rgba(16,124,65,.065);
    border-color: rgba(16,124,65,.12);
  }

  .global-search-result-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
  }

  .global-search-result-category {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .07em;
    text-transform: uppercase;
    color: #107c41;
  }

  .global-search-result strong {
    display: block;
    font-size: 15px;
    line-height: 1.3;
  }

  .global-search-result p {
    margin: 4px 0 0;
    font-size: 12px;
    line-height: 1.45;
    color: rgba(20,29,39,.62);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .global-search-footer {
    flex: 0 0 auto;
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    border-top: 1px solid rgba(20,29,39,.07);
    padding: 10px 24px 12px;
    color: rgba(20,29,39,.48);
    font-size: 10px;
  }

  @media (max-width: 900px) {
    .header-search kbd {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .header-search {
      display: none;
    }

    .global-search-layer {
      padding:
        max(10px, env(safe-area-inset-top))
        10px
        10px;
      place-items: start center;
    }

    .global-search-dialog {
      width: 100%;
      max-height: calc(100dvh - max(20px, env(safe-area-inset-top)));
      border-radius: 15px 15px 22px 22px;
    }

    .global-search-head {
      padding: 18px 17px 8px;
    }

    .global-search-input-wrap {
      margin: 8px 17px 0;
    }

    .global-search-input-wrap kbd {
      display: none;
    }

    .global-search-hints,
    .global-search-status {
      padding-left: 17px;
      padding-right: 17px;
    }

    .global-search-results {
      padding-left: 7px;
      padding-right: 7px;
    }

    .global-search-result {
      padding: 12px 10px;
    }

    .global-search-footer {
      display: none;
    }
  }
</style>
