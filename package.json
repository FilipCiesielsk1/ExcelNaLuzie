{
  "name": "excelnaluzie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run generate:formatting-examples && npm run test:formatting-examples && npm run validate:content && npm run validate:relations && npm run test:tools && npm run test:tables && npm run test:pivot && npm run test:inquiries && astro build && npm run validate:site && npm run validate:ui && pagefind --site dist",
    "preview": "astro preview",
    "validate": "npm run validate:content && npm run validate:relations",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:site": "node scripts/validate-built-site.mjs",
    "validate:relations": "node scripts/validate-relationships.mjs",
    "validate:ui": "node scripts/validate-ui.mjs",
    "test:tools": "node --test scripts/test-formula-tools.mjs",
    "test:tables": "node --test scripts/test-table-compare.mjs",
    "test:pivot": "node --test scripts/test-pivot-builder.mjs",
    "test:inquiries": "node --test scripts/test-project-inquiry.mjs",
    "generate:formatting-examples": "node scripts/generate-formatting-examples.mjs",
    "test:formatting-examples": "node --test scripts/test-formatting-examples.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^7.3.5",
    "read-excel-file": "^9.3.10",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
